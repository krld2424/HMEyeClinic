---
import {
  Activity,
  ArrowDownToLine,
  ArrowUpFromLine,
  BarChart3,
  Bell,
  Boxes,
  CalendarDays,
  CalendarPlus,
  ClipboardList,
  ClipboardPenLine,
  ContactRound,
  CreditCard,
  FileText,
  History,
  House,
  LayoutDashboard,
  ListChecks,
  LogOut,
  Package,
  Pill,
  PanelLeft,
  ReceiptText,
  RefreshCw,
  ShoppingCart,
  ScrollText,
  Settings,
  ShieldCheck,
  Stethoscope,
  Truck,
  UserCheck,
  UserCog,
  UserRound,
  UsersRound,
  WalletCards,
} from '@lucide/astro';

const { name } = Astro.props;
const icons = {
  dashboard: LayoutDashboard,
  'book-exam': CalendarPlus,
  appointments: CalendarDays,
  'medical-records': FileText,
  prescriptions: Pill,
  notifications: Bell,
  profile: UserRound,
  'today-patients': ClipboardList,
  consultations: Stethoscope,
  'clinical-records': FileText,
  'follow-ups': RefreshCw,
  'clinic-queue': ListChecks,
  'check-in': UserCheck,
  'patient-records': ContactRound,
  billing: ReceiptText,
  reports: BarChart3,
  'manage-team': UsersRound,
  'manage-users': UserCog,
  'roles-permissions': ShieldCheck,
  'audit-logs': ScrollText,
  'clinic-settings': Settings,
  signout: LogOut,
  home: House,
  'panel-left': PanelLeft,
  overview: LayoutDashboard,
  care: Activity,
  'clinical-work': Stethoscope,
  operations: ClipboardList,
  account: UserRound,
  management: UserCog,
  'monitoring-settings': Settings,
  'transactions-inventory': Boxes,
  'supplier-transactions': Truck,
  suppliers: Truck,
  'purchase-orders': ShoppingCart,
  receiving: Package,
  'purchase-history': History,
  inventory: Boxes,
  'stock-movements': Boxes,
  'stock-in': ArrowDownToLine,
  'stock-out': ArrowUpFromLine,
  'stock-adjustment': ClipboardPenLine,
  'inventory-history': History,
  'billing-invoices': ReceiptText,
  'customer-payments': CreditCard,
  'payment-history': History,
  'outstanding-balances': WalletCards,
};

const Icon = icons[name] || Activity;
---

<Icon class="sidebar-link-icon" size={16} strokeWidth={1.7} aria-hidden="true" />
