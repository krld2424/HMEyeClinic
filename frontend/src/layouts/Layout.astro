---
import '../styles.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Hernandez Mercado Eye Clinic offers comprehensive eye care, accurate examinations, and stylish eyewear in Santa Rosa, Nueva Ecija."
    />
    <meta name="generator" content={Astro.generator} />
    <title>Hernandez Mercado Eye Clinic | Healthy Eyes, Meaningful Lives</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Manrope:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  </head>
  <body>
    <slot />
  </body>
  <script>
    const localToday = () => {
      const date = new Date();
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    };

    const isDateFilter = (input) => {
      const label = input.getAttribute('aria-label') || '';
      return input.matches('[id$="-date-filter"], [id$="-date-from"], [id$="-date-to"], #today-patient-date')
        || label.toLowerCase().startsWith('filter');
    };

    const setMinimumDate = (input) => {
      if (input instanceof HTMLInputElement && input.type === 'date' && !isDateFilter(input)) {
        input.min = localToday();
      }
    };

    document.querySelectorAll('input[type="date"]').forEach(setMinimumDate);
    document.addEventListener('focusin', (event) => setMinimumDate(event.target));
    document.addEventListener('change', (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || input.type !== 'date' || isDateFilter(input)) return;

      setMinimumDate(input);
      const isPastDate = input.value && input.value < localToday();
      input.setCustomValidity(isPastDate ? 'Choose today or a future date.' : '');
      if (isPastDate) input.reportValidity();
    });
    document.addEventListener('submit', (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement)) return;

      const pastDateInput = [...form.querySelectorAll('input[type="date"]')]
        .find((input) => !isDateFilter(input) && input.value && input.value < localToday());
      if (!pastDateInput) return;

      pastDateInput.setCustomValidity('Choose today or a future date.');
      event.preventDefault();
      event.stopImmediatePropagation();
      pastDateInput.reportValidity();
    }, true);
  </script>
</html>
