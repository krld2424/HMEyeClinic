---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Clinic Access | Hernandez Mercado Eye Clinic">
  <main class="auth-page">
    <section class="auth-shell container">
      <div class="auth-hero">
        <h1>Welcome back to your eye care portal.</h1>
        <p>
          Access patient care, optometry, and clinic operations through your
          secure HM VisionSync account.
        </p>

        <div class="auth-role-list">
          <div class="auth-role-item">
            <strong>Patient</strong>
            <span>Book visits, review records, and track care.</span>
          </div>
          <div class="auth-role-item">
            <strong>Owner</strong>
            <span>Manage the clinic and perform optometrist functions.</span>
          </div>
          <div class="auth-role-item">
            <strong>Optometrist</strong>
            <span>Manage appointments, consultations, and patient care.</span>
          </div>
          <div class="auth-role-item">
            <strong>Eye Care Assistant</strong>
            <span>Coordinate services, check-in, and clinic operations.</span>
          </div>
        </div>
      </div>

      <div class="auth-card">
        <div class="auth-tabs">
          <a class="auth-tab active" href="/login">Login</a>
          <a class="auth-tab" href="/register">Register</a>
        </div>

        <form id="login-form" class="auth-form active">
          <div class="field-group">
            <label for="login-email">Email</label>
            <input id="login-email" name="email" type="email" placeholder="name@example.com" required />
          </div>

          <div class="field-group">
            <label for="login-password">Password</label>
            <div class="password-field">
              <input id="login-password" name="password" type="password" placeholder="••••••••" required />
              <button class="password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password">Show</button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary auth-submit">Sign In</button>
        </form>

        <form id="register-form" class="auth-form">
          <div class="field-group">
            <label for="register-name">Full name</label>
            <input id="register-name" name="name" type="text" placeholder="Your full name" required />
          </div>

          <div class="field-group">
            <label for="register-age">Age</label>
            <input id="register-age" name="age" type="number" inputmode="numeric" min="0" max="120" step="1" placeholder="Age" required />
          </div>

          <div class="field-group">
            <label for="register-email">Email</label>
            <input id="register-email" name="email" type="email" placeholder="name@example.com" required />
          </div>

          <div class="field-group">
            <label for="register-phone">Phone</label>
            <input id="register-phone" name="phone" type="tel" placeholder="+63 000-000-0000" inputmode="tel" pattern="\\+63 [0-9]{3}-[0-9]{3}-[0-9]{4}" maxlength="16" required />
          </div>

          <div class="field-group">
            <label for="register-password">Password</label>
            <div class="password-field">
              <input id="register-password" name="password" type="password" placeholder="Create a password" minlength="8" required />
              <button class="password-toggle" type="button" data-password-toggle="register-password" aria-label="Show password">Show</button>
            </div>
          </div>

          <div class="field-group">
            <label for="register-confirm-password">Confirm password</label>
            <div class="password-field">
              <input id="register-confirm-password" name="confirmPassword" type="password" placeholder="Re-enter your password" minlength="8" required />
              <button class="password-toggle" type="button" data-password-toggle="register-confirm-password" aria-label="Show password">Show</button>
            </div>
          </div>

          <button type="submit" class="btn btn-primary auth-submit">Create Account</button>
        </form>
      </div>
    </section>
  </main>

  <script type="module">
    const clearSessionState = () => {
      ['hmVisionToken', 'hmVisionUser'].forEach((key) => localStorage.removeItem(key));
    };

    const token = localStorage.getItem('hmVisionToken');
    let user = null;
    try {
      user = JSON.parse(localStorage.getItem('hmVisionUser') || 'null');
    } catch {
      clearSessionState();
    }

    if (token && user && user.role) {
      window.location.href = `/dashboard/${user.role}/dashboard`;
    } else if (token || user) {
      clearSessionState();
    }

    const tabs = document.querySelectorAll('[data-auth-tab]');
    const forms = {
      login: document.getElementById('login-form'),
      register: document.getElementById('register-form'),
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.dataset.authTab;

        tabs.forEach((item) => item.classList.toggle('active', item === tab));
        forms.login.classList.toggle('active', target === 'login');
        forms.register.classList.toggle('active', target === 'register');
      });
    });

    const api = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';
    const ageInput = document.getElementById('register-age');
    const phoneInput = document.getElementById('register-phone');

    ageInput?.addEventListener('input', () => {
      ageInput.value = ageInput.value.replace(/\D/g, '').slice(0, 3);
    });

    phoneInput?.addEventListener('input', () => {
      const digits = phoneInput.value.replace(/\D/g, '').replace(/^63/, '').slice(0, 10);
      const groups = [digits.slice(0, 3), digits.slice(3, 6), digits.slice(6, 10)].filter(Boolean);
      phoneInput.value = groups.length ? `+63 ${groups.join('-')}` : '';
    });

    document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const input = document.getElementById(toggle.dataset.passwordToggle);
        const isPassword = input.type === 'password';
        input.type = isPassword ? 'text' : 'password';
        toggle.textContent = isPassword ? 'Hide' : 'Show';
        toggle.setAttribute('aria-label', `${isPassword ? 'Hide' : 'Show'} password`);
      });
    });

    const handleLogin = async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      const submitButton = form.querySelector('button[type="submit"]');

      if (form.dataset.submitting === 'true') return;
      form.dataset.submitting = 'true';
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      submitButton.textContent = 'Signing in...';

      const payload = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch(`${api}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Unable to sign in.');
        }

        localStorage.setItem('hmVisionToken', result.token);
        localStorage.setItem('hmVisionUser', JSON.stringify(result.user));
        window.location.href = `/dashboard/${result.user.role}/dashboard`;
      } catch (error) {
        alert(error.message);
        form.dataset.submitting = 'false';
        submitButton.disabled = false;
        submitButton.setAttribute('aria-busy', 'false');
        submitButton.textContent = 'Sign In';
      }
    };

    const handleRegister = async (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!form.checkValidity()) { form.reportValidity(); return; }

      const payload = Object.fromEntries(new FormData(form).entries());
      const ageValue = Number(payload.age);
      if (!Number.isInteger(ageValue) || ageValue < 0 || ageValue > 120) {
        alert('Age must be a whole number between 0 and 120.');
        return;
      }

      if (payload.phone && !/^\+63 \d{3}-\d{3}-\d{4}$/.test(payload.phone)) {
        alert('Phone number must use +63 000-000-0000 format.');
        return;
      }

      if (payload.password !== payload.confirmPassword) {
        alert('Passwords do not match.');
        return;
      }

      delete payload.confirmPassword;

      try {
        const response = await fetch(`${api}/api/auth/register`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.message || 'Unable to create account.');
        }

        localStorage.setItem('hmVisionToken', result.token);
        localStorage.setItem('hmVisionUser', JSON.stringify(result.user));
        window.location.href = `/dashboard/${result.user.role}/dashboard`;
      } catch (error) {
        alert(error.message);
      }
    };

    forms.login.addEventListener('submit', handleLogin);
    forms.register.addEventListener('submit', handleRegister);
  </script>
</Layout>
