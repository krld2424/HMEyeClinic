                    <th>Price</th>
                    <th>Discount</th>
                    <th>Tax</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  ${items.map(item => `
                    <tr>
                      <td>${escapeHtml(item.description || '')}</td>
                      <td>${item.quantity || 0}</td>
                      <td>${peso(item.unitPrice)}</td>
                      <td>${peso(item.discount)}</td>
                      <td>${peso(item.tax)}</td>
                      <td>${peso(item.lineTotal)}</td>
                    </tr>
                  `).join('') || '<tr><td colspan="6">No line items</td></tr>'}
                </tbody>
              </table>
            `;
          }
          if (el.type === 'customer') {
            return `
              <strong>Bill To</strong><br>
              ${escapeHtml(data.patientName || '—')}<br>
              ${data.customerPhone ? `${escapeHtml(data.customerPhone)}<br>` : ''}
              ${data.customerEmail ? `${escapeHtml(data.customerEmail)}` : ''}
            `;
          }
          if (el.type === 'total') {
            return `
              <div class="invoice-totals">
                <span>Subtotal <b>${peso(subtotal)}</b></span>
                ${discountTotal > 0 ? `<span>Discount <b>-${peso(discountTotal)}</b></span>` : ''}
                ${taxTotal > 0 ? `<span>Tax <b>${peso(taxTotal)}</b></span>` : ''}
                <strong>Total <b>${peso(data.total)}</b></strong>
                <span>Amount Paid <b>${peso(data.paid)}</b></span>
                <strong>Outstanding Balance <b>${peso(data.balance)}</b></strong>
              </div>
            `;
          }
          if (el.type === 'payment') {
            return `
              <strong>Payment</strong><br>
              ${escapeHtml(data.paymentMethod || '—')} · ${escapeHtml(data.paymentReference || '—')}<br>
              ${escapeHtml(data.paymentDate || '—')}
            `;
          }
          if (el.type === 'divider' || el.type === 'line') {
            return `<hr style="border: 0; border-top: 2px solid ${el.style?.color || '#e2e8f0'};">`;
          }
          if (el.type === 'image') {
            return el.text ? `<img src="${escapeHtml(el.text)}" class="invoice-logo-img" alt="Logo" onerror="this.style.display='none';" />` : '';
          }
          if (el.type === 'signature') {
            return `<div class="signature-line">Authorized signature</div>`;
          }
          const rawText = el.field ? `{{${el.field}}}` : el.text;
          return replaceTokens(rawText).replaceAll('\n', '<br>');
        };

        const renderElements = elements.map(el => {
          const s = el.style || {};
          const cssText = `position:absolute;left:${el.x}px;top:${el.y}px;width:${el.w}px;height:${el.h}px;font-family:${s.font || 'Arial'};font-size:${s.size || 12}px;font-weight:${s.bold ? '700':'400'};font-style:${s.italic ? 'italic':'normal'};text-decoration:${s.underline ? 'underline':'none'};color:${s.color || '#1f2937'};text-align:${s.align || 'left'};overflow:hidden;line-height:1.35;`;
          return `<article class="invoice-element" style="${cssText}"><div class="invoice-element-content">${elementHtml(el)}</div></article>`;
        }).join('');

        return `
          <div class="invoice-canvas-wrapper">
            <div class="invoice-canvas" style="position:relative;width:794px;height:1123px;background:white;color:#1f2937;box-shadow:none;border:1px solid #cbd5e1;margin:0 auto;">
              ${renderElements}
            </div>
          </div>
        `;
      };
      const dummyInvoiceMarkup = (invoice) => {
        const data = invoice.data || {};
        const items = Array.isArray(data.items) ? data.items : [];
        return `<div class="billing-document"><h3>${escapeHtml(data.invoiceNumber || 'Invoice')}</h3><div class="billing-doc-grid"><span><strong>Customer</strong>${escapeHtml(data.patientName || '—')}</span><span><strong>Contact</strong>${escapeHtml(data.customerPhone || '—')} · ${escapeHtml(data.customerEmail || '—')}</span><span><strong>Invoice date</strong>${escapeHtml(data.invoiceDate || '—')}</span><span><strong>Due date</strong>${escapeHtml(data.dueDate || '—')}</span><span><strong>Status</strong>${escapeHtml(statusLabel(data.status))}</span></div><table class="appointment-table"><thead><tr><th>Item</th><th>Qty</th><th>Unit</th><th>Discount</th><th>Tax</th><th>Total</th></tr></thead><tbody>${items.map((item) => `<tr><td>${escapeHtml(item.description || '')}</td><td>${item.quantity || 0}</td><td>${peso(item.unitPrice)}</td><td>${peso(item.discount)}</td><td>${peso(item.tax)}</td><td>${peso(item.lineTotal)}</td></tr>`).join('') || '<tr><td colspan="6">No line items</td></tr>'}</tbody></table><p>Total ${peso(data.total)} · Paid ${peso(data.paid)} · Balance ${peso(data.balance)}</p></div>`;
      };
      const receiptMarkup = (payment) => {
        const data = payment.data || {};
        return `<div class="billing-document"><h3>Payment receipt ${escapeHtml(data.receiptNumber || '')}</h3><div class="billing-doc-grid"><span><strong>Customer</strong>${escapeHtml(data.patientName || '—')}</span><span><strong>Invoice</strong>${escapeHtml(data.invoiceNumber || '—')}</span><span><strong>Date</strong>${escapeHtml(data.paymentDate || '—')}</span><span><strong>Method</strong>${escapeHtml(data.method || '—')}</span><span><strong>Reference</strong>${escapeHtml(data.reference || '—')}</span><span><strong>Status</strong>${escapeHtml(statusLabel(data.status))}</span></div><p class="billing-total">Amount paid <strong>${peso(data.amount)}</strong></p>${data.notes ? `<p>${escapeHtml(data.notes)}</p>` : ''}</div>`;
      };
      const outstandingInvoices = () => billingInvoices.filter((invoice) => !['paid', 'cancelled'].includes(invoice.data?.status) && Number(invoice.data?.balance || 0) > 0);
      const fillPaymentInvoices = () => {
        const customerSelect = document.getElementById('billing-payment-customer');
        const invoiceSelect = document.getElementById('billing-payment-invoice');
        if (!invoiceSelect) return;
        const selectedCustomer = customerSelect?.selectedOptions[0];
        const customerName = selectedCustomer?.dataset.name || '';
        const invoices = outstandingInvoices().filter((invoice) => !customerName || invoice.data?.patientName === customerName);
        const current = invoiceSelect.value;
        invoiceSelect.innerHTML = `<option value="">Select an invoice</option>${invoices.map((invoice) => `<option value="${invoice._id}" ${invoice._id === current ? 'selected' : ''}>${escapeHtml(invoice.data.invoiceNumber)} · ${peso(invoice.data.balance)}</option>`).join('')}`;
        updatePaymentSnapshot();
      };
      const updatePaymentSnapshot = () => {
        const invoice = billingInvoices.find((item) => item._id === document.getElementById('billing-payment-invoice')?.value);
        const snapshot = document.getElementById('billing-invoice-snapshot');
        if (!snapshot) return;
        snapshot.innerHTML = `<span>Invoice total <strong>${peso(invoice?.data?.total)}</strong></span><span>Outstanding <strong>${peso(invoice?.data?.balance)}</strong></span>`;
        const amount = document.getElementById('billing-payment-amount');
        if (amount && invoice) amount.max = invoice.data.balance;
      };
      const renderBilling = () => {
        const query = (document.getElementById('billing-search')?.value || '').toLowerCase().trim();
        const status = document.getElementById('billing-status-filter')?.value || '';
        if (section === 'billing-invoices' || section === 'invoice-templates') {
          const date = document.getElementById('billing-date-filter')?.value || '';
          const rows = billingInvoices.filter((invoice) => {
            const data = invoice.data || {};
            return (!status || data.status === status) && (!date || data.invoiceDate === date) && (!query || `${data.invoiceNumber} ${data.patientName}`.toLowerCase().includes(query));
          });
          billingList.innerHTML = rows.length ? `<div class="appointment-table-wrap"><table class="appointment-table billing-table"><thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Due</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th><th>Actions</th></tr></thead><tbody>${rows.map((invoice) => {
            const data = invoice.data || {};
            const locked = Number(data.paid || 0) > 0 || data.status === 'cancelled';
            return `<tr class="${data.status === 'overdue' ? 'is-overdue' : ''}"><td data-label="Invoice"><strong>${escapeHtml(data.invoiceNumber)}</strong></td><td data-label="Customer">${escapeHtml(data.patientName)}<small>${escapeHtml(data.customerEmail || data.customerPhone || '')}</small></td><td data-label="Date">${escapeHtml(data.invoiceDate || '—')}</td><td data-label="Due">${escapeHtml(data.dueDate || '—')}</td><td data-label="Total" class="table-number">${peso(data.total)}</td><td data-label="Paid" class="table-number">${peso(data.paid)}</td><td data-label="Balance" class="table-number">${peso(data.balance)}</td><td data-label="Status"><span class="${statusClass(data.status)}">${statusLabel(data.status)}</span></td><td data-label="Actions"><div class="table-actions"><button type="button" class="btn btn-secondary" data-billing-view="invoice" data-id="${invoice._id}">View</button><button type="button" class="btn btn-secondary action-edit" data-billing-edit="${invoice._id}" ${locked ? 'disabled' : ''}>Edit</button><button type="button" class="btn btn-secondary action-delete" data-billing-cancel="${invoice._id}" ${locked ? 'disabled' : ''}>Cancel</button></div></td></tr>`;
          }).join('')}</tbody></table></div>` : '<p class="empty-appointments">No invoices match these filters.</p>';
          return;
        }
        if (section === 'outstanding-balances') {
          const sort = document.getElementById('billing-sort')?.value || 'dueDate';
          const rows = outstandingInvoices().filter((invoice) => {
            const data = invoice.data || {};
            return (!status || data.status === status) && (!query || `${data.invoiceNumber} ${data.patientName}`.toLowerCase().includes(query));
          }).sort((first, second) => sort === 'balance' ? Number(second.data.balance) - Number(first.data.balance) : String(first.data.dueDate || '').localeCompare(String(second.data.dueDate || '')));
          billingList.innerHTML = rows.length ? `<div class="appointment-table-wrap"><table class="appointment-table billing-table"><thead><tr><th>Customer</th><th>Invoice</th><th>Invoice date</th><th>Due date</th><th>Total</th><th>Paid</th><th>Outstanding</th><th>Status</th><th>Days overdue</th><th>Actions</th></tr></thead><tbody>${rows.map((invoice) => {
            const data = invoice.data || {};
            return `<tr class="${data.status === 'overdue' ? 'is-overdue' : ''}"><td data-label="Customer">${escapeHtml(data.patientName)}</td><td data-label="Invoice">${escapeHtml(data.invoiceNumber)}</td><td data-label="Invoice date">${escapeHtml(data.invoiceDate || '—')}</td><td data-label="Due date">${escapeHtml(data.dueDate || '—')}</td><td data-label="Total" class="table-number">${peso(data.total)}</td><td data-label="Paid" class="table-number">${peso(data.paid)}</td><td data-label="Outstanding" class="table-number">${peso(data.balance)}</td><td data-label="Status"><span class="${statusClass(data.status)}">${statusLabel(data.status)}</span></td><td data-label="Days overdue">${invoice.daysOverdue || 0}</td><td data-label="Actions"><div class="table-actions"><button type="button" class="btn btn-secondary" data-billing-view="invoice" data-id="${invoice._id}">View</button><button type="button" class="btn btn-primary" data-billing-pay="${invoice._id}">Record payment</button><button type="button" class="btn btn-secondary" data-billing-remind="${invoice._id}">Remind</button></div></td></tr>`;
          }).join('')}</tbody></table></div>` : '<p class="empty-appointments">No outstanding balances.</p>';
          return;
        }
        const customer = document.getElementById('billing-customer-filter')?.value || '';
        const method = document.getElementById('billing-method-filter')?.value || '';
        const paymentStatusFilter = document.getElementById('billing-payment-status-filter')?.value || '';
        const from = document.getElementById('billing-date-from')?.value || '';
        const to = document.getElementById('billing-date-to')?.value || '';
        const rows = billingPayments.filter((payment) => {
          const data = payment.data || {};
          const date = data.paymentDate || String(payment.createdAt || '').slice(0, 10);
          return (!customer || data.patientName === customer) && (!method || data.method === method) && (!paymentStatusFilter || data.status === paymentStatusFilter) && (!from || date >= from) && (!to || date <= to) && (!query || `${data.receiptNumber} ${data.patientName} ${data.invoiceNumber} ${data.reference}`.toLowerCase().includes(query));
        });
        billingList.innerHTML = rows.length ? `<div class="appointment-table-wrap"><table class="appointment-table billing-table"><thead><tr><th>Payment ID</th><th>Receipt</th><th>Customer</th><th>Invoice</th><th>Date</th><th>Amount</th><th>Method</th><th>Reference</th><th>Recorded by</th><th>Status</th><th>Actions</th></tr></thead><tbody>${rows.map((payment) => {
          const data = payment.data || {};
          const reversed = data.status === 'reversed';
          return `<tr><td data-label="Payment ID"><small>${escapeHtml(payment._id)}</small></td><td data-label="Receipt">${escapeHtml(data.receiptNumber || '—')}</td><td data-label="Customer">${escapeHtml(data.patientName || '—')}</td><td data-label="Invoice">${escapeHtml(data.invoiceNumber || '—')}</td><td data-label="Date">${escapeHtml(data.paymentDate || '—')}</td><td data-label="Amount" class="table-number">${peso(data.amount)}</td><td data-label="Method">${escapeHtml(data.method || '—')}</td><td data-label="Reference">${escapeHtml(data.reference || '—')}</td><td data-label="Recorded by">${escapeHtml(payment.createdBy?.name || data.recordedBy || '—')}</td><td data-label="Status"><span class="${statusClass(data.status)}">${statusLabel(data.status)}</span></td><td data-label="Actions"><div class="table-actions"><button type="button" class="btn btn-secondary" data-billing-view="payment" data-id="${payment._id}">View</button>${reversed ? '' : `<button type="button" class="btn btn-secondary action-delete" data-billing-reverse="${payment._id}">Reverse</button>`}</div></td></tr>`;
        }).join('')}</tbody></table></div>` : '<p class="empty-appointments">No payments match these filters.</p>';
      };
      const loadBilling = async () => {
        const [invoiceResponse, paymentResponse, userResponse, templateResponse] = await Promise.all([
          fetch(`${api}/api/clinic-operations?type=invoice`, { headers: billingHeaders }),
          fetch(`${api}/api/clinic-operations?type=payment`, { headers: billingHeaders }),
          fetch(`${api}/api/admin/users`, { headers: billingHeaders }),
          fetch(`${api}/api/invoice-templates`, { headers: billingHeaders }),
        ]);
        const invoices = await invoiceResponse.json();
        const payments = await paymentResponse.json();
        const users = await userResponse.json();
        const templateResult = await templateResponse.json();
        if (!invoiceResponse.ok) throw new Error(invoices.message || 'Unable to load invoices.');
        if (!paymentResponse.ok) throw new Error(payments.message || 'Unable to load payments.');
        billingInvoices = invoices.records || [];
        billingPayments = payments.records || [];
        billingTemplates = templateResult.templates || [];
        billingCustomers = (users.users || []).filter((item) => item.role === 'patient');
        const templateSelect = document.getElementById('billing-template');
        if (templateSelect && templateResponse.ok) {
          const defaultTemplate = (templateResult.templates || []).find((template) => template.isDefault) || templateResult.templates?.[0];
          if (defaultTemplate) {
            templateSelect.value = defaultTemplate._id;
          }
        }
        fillCustomerSelects();
        fillPaymentInvoices();
        renderBilling();
      };
      if (itemsBody && !itemsBody.children.length) itemsBody.innerHTML = itemRowMarkup();
      const invoiceDate = document.getElementById('billing-invoice-date');
      const dueDate = document.getElementById('billing-due-date');
      const paymentDate = document.getElementById('billing-payment-date');
      if (invoiceDate && !invoiceDate.value) invoiceDate.value = todayIso();
      if (dueDate && !dueDate.value) dueDate.value = todayIso();
      if (paymentDate && !paymentDate.value) paymentDate.value = todayIso();
      document.getElementById('billing-add-item')?.addEventListener('click', () => { itemsBody.insertAdjacentHTML('beforeend', itemRowMarkup()); refreshInvoiceTotal(); });
      itemsBody?.addEventListener('input', refreshInvoiceTotal);
      itemsBody?.addEventListener('click', (event) => {
        if (event.target.closest('.billing-remove-item') && itemsBody.rows.length > 1) {
          event.target.closest('tr').remove();
          refreshInvoiceTotal();
        }
      });
      document.getElementById('billing-customer')?.addEventListener('change', () => applyCustomerDetails('billing-customer'));
      document.getElementById('billing-payment-customer')?.addEventListener('change', fillPaymentInvoices);
      document.getElementById('billing-payment-invoice')?.addEventListener('change', updatePaymentSnapshot);
      ['billing-search', 'billing-status-filter', 'billing-date-filter', 'billing-customer-filter', 'billing-method-filter', 'billing-payment-status-filter', 'billing-date-from', 'billing-date-to', 'billing-sort'].forEach((id) => {
        document.getElementById(id)?.addEventListener('input', renderBilling);
        document.getElementById(id)?.addEventListener('change', renderBilling);
      });
      invoiceForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const customer = applyCustomerDetails('billing-customer');
        if (!customer.patientName) { invoiceStatus.textContent = 'Select a customer.'; invoiceStatus.classList.add('error'); return; }
        if (!window.confirm(editingInvoiceId ? 'Update this invoice?' : 'Create this invoice?')) return;
        const payload = {
          ...customer,
          invoiceDate: invoiceDate.value,
          dueDate: dueDate.value,
          templateId: document.getElementById('billing-template')?.value || undefined,
          items: collectItems(),
        };
        invoiceStatus.textContent = 'Saving invoice...';
        invoiceStatus.classList.remove('error');
        try {
          const response = await fetch(editingInvoiceId ? `${api}/api/clinic-operations/${editingInvoiceId}` : `${api}/api/clinic-operations/invoice`, { method: editingInvoiceId ? 'PATCH' : 'POST', headers: billingHeaders, body: JSON.stringify(payload) });
          const result = await response.json();
          if (!response.ok) throw new Error(result.message || 'Unable to save invoice.');
          invoiceForm.reset();
          editingInvoiceId = '';
          itemsBody.innerHTML = itemRowMarkup();
          if (invoiceDate) invoiceDate.value = todayIso();
          if (dueDate) dueDate.value = todayIso();
          invoiceForm.querySelector('button[type="submit"]').textContent = 'Create invoice';
          invoiceStatus.textContent = result.record?.data?.invoiceNumber ? `Invoice ${result.record.data.invoiceNumber} saved.` : 'Invoice saved.';
          await loadBilling();
        } catch (error) { invoiceStatus.textContent = error.message; invoiceStatus.classList.add('error'); }
      });
      paymentForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const invoiceId = document.getElementById('billing-payment-invoice')?.value;
        const invoice = billingInvoices.find((item) => item._id === invoiceId);
        const amount = Number(document.getElementById('billing-payment-amount')?.value);
        if (!invoice) { paymentStatus.textContent = 'Select an invoice.'; paymentStatus.classList.add('error'); return; }
        if (amount > Number(invoice.data.balance || 0)) { paymentStatus.textContent = 'Payment cannot exceed the remaining balance.'; paymentStatus.classList.add('error'); return; }
        if (!window.confirm('Record this payment?')) return;
        paymentStatus.textContent = 'Recording payment...';
        paymentStatus.classList.remove('error');
        try {
          const response = await fetch(`${api}/api/clinic-operations/payment`, { method: 'POST', headers: billingHeaders, body: JSON.stringify({
            invoiceId,
            amount,
            method: document.getElementById('billing-payment-method')?.value,
            reference: document.getElementById('billing-payment-reference')?.value,
            paymentDate: document.getElementById('billing-payment-date')?.value,
            notes: document.getElementById('billing-payment-notes')?.value,
            patientName: invoice.data.patientName,
            patientId: invoice.data.patientId,
          }) });
          const result = await response.json();
          if (!response.ok) throw new Error(result.message || 'Unable to record payment.');
          paymentForm.reset();
          if (paymentDate) paymentDate.value = todayIso();
          paymentStatus.textContent = result.record?.data?.receiptNumber ? `Receipt ${result.record.data.receiptNumber} recorded.` : 'Payment recorded.';
          await loadBilling();
          detailTitle.textContent = 'Payment receipt';
          detailContent.innerHTML = receiptMarkup(result.record);
          detailModal?.showModal();
        } catch (error) { paymentStatus.textContent = error.message; paymentStatus.classList.add('error'); }
      });
      billingList.addEventListener('click', async (event) => {
        const view = event.target.closest('[data-billing-view]');
        const edit = event.target.closest('[data-billing-edit]');
        const cancel = event.target.closest('[data-billing-cancel]');
        const reverse = event.target.closest('[data-billing-reverse]');
        const pay = event.target.closest('[data-billing-pay]');
        const remind = event.target.closest('[data-billing-remind]');
        if (view) {
          const kind = view.dataset.billingView;
          const record = kind === 'invoice' ? billingInvoices.find((item) => item._id === view.dataset.id) : billingPayments.find((item) => item._id === view.dataset.id);
          if (!record) return;
          detailTitle.textContent = kind === 'invoice' ? record.data.invoiceNumber : record.data.receiptNumber;
          detailContent.innerHTML = kind === 'invoice' ? invoiceMarkup(record) : receiptMarkup(record);
          detailModal?.showModal();
        }
        if (edit) {
          const invoice = billingInvoices.find((item) => item._id === edit.dataset.billingEdit);
          if (!invoice || !invoiceForm) return;
          editingInvoiceId = invoice._id;
          const customer = billingCustomers.find((item) => item.patientId === invoice.data.patientId || item.name === invoice.data.patientName);
          if (customer) document.getElementById('billing-customer').value = customer._id;
          applyCustomerDetails('billing-customer');
          document.getElementById('billing-invoice-number').value = invoice.data.invoiceNumber || '';
          invoiceDate.value = invoice.data.invoiceDate || todayIso();
          dueDate.value = invoice.data.dueDate || todayIso();
          itemsBody.innerHTML = (invoice.data.items || []).map((item) => itemRowMarkup(item)).join('') || itemRowMarkup();
          refreshInvoiceTotal();
          invoiceForm.querySelector('button[type="submit"]').textContent = 'Update invoice';
          invoiceForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (cancel) {
          if (!window.confirm('Cancel this invoice? This cannot be undone unless no payments were recorded.')) return;
          const response = await fetch(`${api}/api/clinic-operations/invoice/${cancel.dataset.billingCancel}/cancel`, { method: 'POST', headers: billingHeaders });
          const result = await response.json();
          if (!response.ok) { alert(result.message || 'Unable to cancel invoice.'); return; }
          await loadBilling();
        }
        if (reverse) {
          if (!window.confirm('Reverse this payment? The invoice balance will be restored.')) return;
          const response = await fetch(`${api}/api/clinic-operations/payment/${reverse.dataset.billingReverse}/reverse`, { method: 'POST', headers: billingHeaders, body: JSON.stringify({ reason: 'Owner reversal' }) });
          const result = await response.json();
          if (!response.ok) { alert(result.message || 'Unable to reverse payment.'); return; }
          await loadBilling();
        }
        if (pay) {
          const invoice = billingInvoices.find((item) => item._id === pay.dataset.billingPay);
          const customer = billingCustomers.find((item) => item.patientId === invoice?.data?.patientId || item.name === invoice?.data?.patientName);
          if (customer) document.getElementById('billing-payment-customer').value = customer._id;
          fillPaymentInvoices();
          document.getElementById('billing-payment-invoice').value = invoice._id;
          updatePaymentSnapshot();
          paymentForm?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (remind) {
          const response = await fetch(`${api}/api/clinic-operations/invoice/${remind.dataset.billingRemind}/reminder`, { method: 'POST', headers: billingHeaders });
          const result = await response.json();
          alert(result.message || 'Reminder processed.');
        }
      });
      document.getElementById('billing-detail-close')?.addEventListener('click', () => detailModal?.close());
      document.getElementById('billing-print')?.addEventListener('click', () => openPrint(detailTitle?.textContent || 'Document', detailContent?.innerHTML || ''));
      document.getElementById('billing-export')?.addEventListener('click', () => {
        const rows = [['Payment ID', 'Receipt', 'Customer', 'Invoice', 'Date', 'Amount', 'Method', 'Reference', 'Recorded By', 'Status']];
        billingPayments.forEach((payment) => {
          const data = payment.data || {};
          rows.push([payment._id, data.receiptNumber, data.patientName, data.invoiceNumber, data.paymentDate, data.amount, data.method, data.reference, payment.createdBy?.name || data.recordedBy, data.status]);
        });
        const csv = rows.map((row) => row.map((value) => `"${String(value || '').replace(/"/g, '""')}"`).join(',')).join('\n');
        const link = document.createElement('a');
        link.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
        link.download = 'payment-history.csv';
        link.click();
      });
      loadBilling().catch((error) => { billingList.innerHTML = `<p class="empty-appointments">${escapeHtml(error.message)}</p>`; });

      // Tab switching logic for Billing / Invoices and Invoice Templates
      const switchBillingTab = (tab) => {
        const invoicesBtn = document.querySelector('.billing-tab-btn[data-tab="invoices"]');
        const templateBtn = document.querySelector('.billing-tab-btn[data-tab="template"]');
        const invoicesTab = document.getElementById('billing-invoices-tab-content');
        const templateTab = document.getElementById('invoice-templates-tab-content');
        const headerTitle = document.querySelector('.dashboard-header h1');

        if (tab === 'invoices') {
          invoicesBtn?.classList.add('active');
          templateBtn?.classList.remove('active');
          if (invoicesTab) invoicesTab.style.display = 'block';
          if (templateTab) templateTab.style.display = 'none';
          if (headerTitle) headerTitle.textContent = 'Billing / Invoices';
          window.history.pushState({}, '', `/dashboard/${role}/billing-invoices`);
          renderBilling();
        } else if (tab === 'template') {
          invoicesBtn?.classList.remove('active');
          templateBtn?.classList.add('active');
          if (invoicesTab) invoicesTab.style.display = 'none';
          if (templateTab) templateTab.style.display = 'block';
          if (headerTitle) headerTitle.textContent = 'Invoice Templates';
          window.history.pushState({}, '', `/dashboard/${role}/invoice-templates`);
          // Dispatch a custom event to notify template builder that it is visible
          window.dispatchEvent(new CustomEvent('invoice-template-tab-active'));
        }
      };

      document.querySelectorAll('.billing-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => switchBillingTab(btn.dataset.tab));
      });

      // Handle template customization link click
      document.querySelectorAll('.billing-tab-link').forEach((link) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          switchBillingTab(link.dataset.tab);
        });
      });
    }

    // Overview Dashboard Logic (when section === 'dashboard')
    if (section === 'dashboard' && role !== 'owner') {
      const appointmentPanel = document.getElementById('appointment-panel');
      const appointmentList = document.getElementById('appointment-list');
      const appointmentSearch = document.getElementById('overview-appointment-search');
      const appointmentStatusFilter = document.getElementById('overview-appointment-status');
      const appointmentDateFilter = document.getElementById('overview-appointment-date');
      const appointmentPagination = document.getElementById('overview-appointment-pagination');
      let appointments = [];
      let appointmentPage = 1;
      const pageSize = 5;

      const appointmentActions = (appointment) => {
        if (role === 'patient') return '<span class="appointment-action-empty">-</span>';
        const actions = {
          pending: [['confirmed', 'Confirm patient'], ['cancelled', 'Reject']],
          confirmed: [['completed', 'Mark completed'], ['rescheduled', 'Reschedule'], ['cancelled', 'Cancel']],
          rescheduled: [['confirmed', 'Confirm patient'], ['cancelled', 'Reject']],
        }[appointment.status] || [];
        if (appointment.status === 'completed' || appointment.status === 'cancelled') return `<a class="btn btn-secondary appointment-action-link" href="/dashboard/${role}/clinical-records">View</a><a class="btn btn-secondary appointment-action-link" href="/dashboard/${role}/clinical-records">View Clinical Record</a>${appointment.status === 'cancelled' ? '<button type="button" class="btn btn-secondary appointment-action action-rescheduled" data-appointment-id="' + escapeHtml(appointment._id) + '" data-status="rescheduled">Reschedule</button>' : ''}`;
        return actions.map(([status, label]) => `<button type="button" class="btn btn-secondary appointment-action action-${status}" data-appointment-id="${escapeHtml(appointment._id)}" data-status="${status}">${label}</button>`).join('');
      };

      const renderAppointmentPage = () => {
        if (!appointmentList) return;
        const query = (appointmentSearch?.value || '').toLowerCase().trim();
        const status = appointmentStatusFilter?.value || '';
        const date = appointmentDateFilter?.value || '';
        const filtered = appointments.filter((item) => (!status || item.status === status) && (!date || item.preferredDate === date) && (!query || `${item.name} ${item.email} ${item.service}`.toLowerCase().includes(query)));
        const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
        appointmentPage = Math.min(appointmentPage, pages);
        const visible = filtered.slice((appointmentPage - 1) * pageSize, appointmentPage * pageSize);
        appointmentList.innerHTML = visible.length ? `<div class="appointment-table-wrap"><table class="appointment-table"><thead><tr><th scope="col">Examination / Appointment</th><th scope="col">Patient</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>${visible.map((item) => `<tr><td data-label="Examination / Appointment"><strong>${escapeHtml(item.service)}</strong></td><td data-label="Patient"><strong>${escapeHtml(item.name)}</strong><small>${escapeHtml(item.email)}</small></td><td data-label="Date">${escapeHtml(item.preferredDate || 'Date to be confirmed')}</td><td data-label="Status"><span class="appointment-status status-${escapeHtml(item.status)}">${escapeHtml(item.status)}</span></td><td data-label="Actions"><div class="appointment-actions">${appointmentActions(item)}</div></td></tr>`).join('')}</tbody></table></div>` : '<p class="empty-appointments">No appointments match these filters.</p>';
        appointmentPagination.innerHTML = pages > 1 ? `<button type="button" class="btn btn-secondary" data-page="prev" ${appointmentPage === 1 ? 'disabled' : ''}>Previous</button><span>Page ${appointmentPage} of ${pages}</span><button type="button" class="btn btn-secondary" data-page="next" ${appointmentPage === pages ? 'disabled' : ''}>Next</button>` : '';
        appointmentPagination.querySelector('[data-page="prev"]')?.addEventListener('click', () => { appointmentPage -= 1; renderAppointmentPage(); });
        appointmentPagination.querySelector('[data-page="next"]')?.addEventListener('click', () => { appointmentPage += 1; renderAppointmentPage(); });
        appointmentList.querySelectorAll('.appointment-action').forEach((button) => button.addEventListener('click', async () => {
          button.disabled = true;
          const response = await fetch(`${api}/api/appointments/${button.dataset.appointmentId}/status`, { method: 'PATCH', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ status: button.dataset.status }) });
          if (!response.ok) { button.disabled = false; return; }
          appointments = appointments.map((item) => item._id === button.dataset.appointmentId ? { ...item, status: button.dataset.status } : item);
          renderAppointmentPage();
        }));
      };

      const loadAppointments = async () => {
        if (!appointmentPanel || !token || !user) return;
        const endpoint = role === 'patient' ? '/api/appointments/mine' : '/api/appointments';
        try {
          const response = await fetch(`${api}${endpoint}`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.message || 'Unable to load appointments.');
          appointmentPanel.hidden = false;
          appointments = result.appointments;
          renderAppointmentPage();
        } catch (error) {
          appointmentPanel.hidden = false;
          appointmentList.innerHTML = `<p class="empty-appointments">${escapeHtml(error.message)}</p>`;
        }
      };

      loadAppointments();
      [appointmentSearch, appointmentStatusFilter, appointmentDateFilter].forEach((control) => control?.addEventListener('input', () => { appointmentPage = 1; renderAppointmentPage(); }));

      if (role === 'owner') {
        const adminPanel = document.getElementById('admin-panel');
        const adminForm = document.getElementById('admin-user-form');
        const adminStatus = document.getElementById('admin-status');
        const managedUsers = document.getElementById('managed-users');
        const adminPhone = document.getElementById('admin-phone');

        adminPhone?.addEventListener('input', () => {
          const digits = adminPhone.value.replace(/\D/g, '').replace(/^63/, '').slice(0, 10);
          adminPhone.value = `+63 ${[digits.slice(0, 3), digits.slice(3, 6), digits.slice(6, 10)].filter(Boolean).join('-')}`;
        });

        const loadManagedUsers = async () => {
          if (!adminPanel) return;
          adminPanel.hidden = false;
          const response = await fetch(`${api}/api/admin/users`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.message || 'Unable to load managed accounts.');

          managedUsers.innerHTML = result.users.length
            ? `<div class="appointment-table-wrap"><table class="appointment-table"><thead><tr><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Email</th><th scope="col">Status</th></tr></thead><tbody>${result.users.map((user) => `<tr><td data-label="Name"><strong>${escapeHtml(user.name)}</strong></td><td data-label="Role">${escapeHtml(user.role)}</td><td data-label="Email">${escapeHtml(user.email)}</td><td data-label="Status"><span class="appointment-status ${user.isActive === false ? 'status-cancelled' : 'status-confirmed'}">${user.isActive === false ? 'Inactive' : 'Active'}</span></td></tr>`).join('')}</tbody></table></div>`
            : '<p class="empty-appointments">No optometrist or eye care assistant accounts yet.</p>';
        };

        adminForm?.addEventListener('submit', async (event) => {
          event.preventDefault();
          adminStatus.textContent = 'Creating account...';
          adminStatus.classList.remove('error');

          try {
            const response = await fetch(`${api}/api/admin/users`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                Authorization: `Bearer ${token}`,
              },
              body: JSON.stringify(Object.fromEntries(new FormData(adminForm).entries())),
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.message || 'Unable to create account.');
            adminStatus.textContent = result.message;
            adminForm.reset();
            await loadManagedUsers();
          } catch (error) {
            adminStatus.textContent = error.message;
            adminStatus.classList.add('error');
          }
        });

        loadManagedUsers().catch((error) => {
          if (adminStatus) {
            adminStatus.textContent = error.message;
            adminStatus.classList.add('error');
          }
        });
      }
    }
  </script>
</Layout>
