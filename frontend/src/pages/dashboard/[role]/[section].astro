              <div class="field-row"><div class="field-group"><label for="profile-phone">Contact number</label><input id="profile-phone" name="phone" type="tel" /></div><div class="field-group"><label for="profile-age">Age</label><input id="profile-age" name="age" type="number" min="0" max="120" /></div></div>
              <div class="field-group"><label for="profile-gender">Gender</label><input id="profile-gender" name="gender" /></div>
