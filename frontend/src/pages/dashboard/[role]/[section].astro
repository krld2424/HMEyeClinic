                      <select id="billing-status-filter"><option value="">All statuses</option><option value="paid">Paid</option><option value="unpaid">Unpaid</option><option value="partially-paid">Partially Paid</option><option value="overdue">Overdue</option><option value="cancelled">Cancelled</option></select>
