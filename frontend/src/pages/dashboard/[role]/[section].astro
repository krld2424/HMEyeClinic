        )
      )}
    </div>
  </main>

  <script>
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const role = pathParts[1];
    const section = pathParts[2];
    const token = localStorage.getItem('hmVisionToken');
    const user = JSON.parse(localStorage.getItem('hmVisionUser') || 'null');
    const api = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';

    if (role === 'owner' && section === 'manage-users') window.location.replace('/dashboard/owner/manage-team');

    const sidebarUserId = document.getElementById('sidebar-user-id');
    if (sidebarUserId) sidebarUserId.textContent = user?.patientId || (user?.role === 'patient' ? 'Unavailable' : user?.id || user?._id || 'Unavailable');

    if (!token || !user || user.role !== role) window.location.href = '/login';

    const sidebarCollapseToggle = document.getElementById('sidebar-collapse-toggle');
    const mobileSidebarToggle = document.getElementById('mobile-sidebar-toggle');
    const sidebarOverlay = document.getElementById('sidebar-overlay');

    const setMobileSidebarOpen = (isOpen) => {
      document.body.classList.toggle('mobile-sidebar-is-open', isOpen);
      mobileSidebarToggle?.setAttribute('aria-expanded', String(isOpen));
      sidebarOverlay?.setAttribute('aria-hidden', String(!isOpen));
    };

    mobileSidebarToggle?.addEventListener('click', () => setMobileSidebarOpen(true));
    sidebarOverlay?.addEventListener('click', () => setMobileSidebarOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMobileSidebarOpen(false);
    });

    document.querySelectorAll('.dashboard-sidebar a').forEach((link) => {
      link.addEventListener('click', () => setMobileSidebarOpen(false));
    });

    sidebarCollapseToggle?.addEventListener('click', () => {
      const isCollapsed = document.body.classList.toggle('sidebar-is-collapsed');
      sidebarCollapseToggle.setAttribute('aria-expanded', String(!isCollapsed));
      sidebarCollapseToggle.setAttribute('aria-label', `${isCollapsed ? 'Expand' : 'Collapse'} sidebar`);
      sidebarCollapseToggle.setAttribute('title', `${isCollapsed ? 'Expand' : 'Collapse'} sidebar`);
    });

    const logout = (event) => {
      event.preventDefault();
      localStorage.removeItem('hmVisionToken');
      localStorage.removeItem('hmVisionUser');
      window.location.href = '/login';
    };
    document.getElementById('sidebar-logout')?.addEventListener('click', logout);
    const notificationButton = document.getElementById('notification-button');
    const notificationPopover = document.getElementById('notification-popover');
    notificationButton?.addEventListener('click', () => {
      const isOpen = notificationButton.getAttribute('aria-expanded') === 'true';
      notificationButton.setAttribute('aria-expanded', String(!isOpen));
      notificationPopover.hidden = isOpen;
    });
    const notificationList = document.getElementById('notification-list');
    const notificationCount = document.getElementById('notification-count');
    const loadNotifications = async () => {
      if (!notificationList) return;
      const headers = { Authorization: `Bearer ${token}` };
      const appointmentResponse = await fetch(`${api}/api/appointments${role === 'patient' ? '/mine' : ''}`, { headers });
      const appointmentResult = await appointmentResponse.json();
      const notifications = [];
      const today = new Date().toISOString().slice(0, 10);
      (appointmentResult.appointments || []).forEach((item) => {
        if (item.preferredDate >= today && ['pending', 'confirmed'].includes(item.status)) notifications.push({ id: `appointment-${item._id}-${item.status}`, text: `${role === 'patient' ? 'Appointment' : `Appointment request from ${item.name}`} ${item.status} for ${item.preferredDate}.`, href: `/dashboard/${role}/appointments` });
      });
      if (['owner', 'optometrist'].includes(role)) {
        const followUpResponse = await fetch(`${api}/api/follow-ups`, { headers });
        const followUpResult = await followUpResponse.json();
        (followUpResult.followUps || []).forEach((item) => { if (['requested', 'scheduled'].includes(item.status)) notifications.push({ id: `follow-up-${item._id}-${item.status}`, text: `Follow-up ${item.status} for ${item.patientName}.`, href: `/dashboard/${role}/follow-ups` }); });
      } else if (role === 'patient') {
        const followUpResponse = await fetch(`${api}/api/follow-ups/mine`, { headers });
        const followUpResult = await followUpResponse.json();
        (followUpResult.followUps || []).forEach((item) => { if (['requested', 'scheduled'].includes(item.status)) notifications.push({ id: `follow-up-${item._id}-${item.status}`, text: `Your follow-up is ${item.status}.`, href: `/dashboard/${role}/follow-ups` }); });
      }
      const readNotifications = JSON.parse(localStorage.getItem('hmVisionReadNotifications') || '[]');
      const visible = notifications.filter((item) => !readNotifications.includes(item.id)).slice(0, 5);
      notificationCount.hidden = !visible.length;
      notificationCount.textContent = visible.length ? visible.length : '';
      notificationList.innerHTML = visible.length ? visible.map((item) => `<a class="notification-item" data-notification-id="${item.id}" href="${item.href}">${item.text}</a>`).join('') : '<p>No new notifications.</p>';
    };
    loadNotifications().catch(() => { if (notificationList) notificationList.innerHTML = '<p>Notifications unavailable.</p>'; });
    notificationList?.addEventListener('click', (event) => {
      const item = event.target.closest('[data-notification-id]');
      if (!item) return;
      const readNotifications = JSON.parse(localStorage.getItem('hmVisionReadNotifications') || '[]');
      if (!readNotifications.includes(item.dataset.notificationId)) readNotifications.push(item.dataset.notificationId);
      localStorage.setItem('hmVisionReadNotifications', JSON.stringify(readNotifications.slice(-100)));
      item.remove();
      const remaining = notificationList.querySelectorAll('[data-notification-id]').length;
      notificationCount.hidden = !remaining;
      notificationCount.textContent = remaining ? remaining : '';
      if (!remaining) notificationList.innerHTML = '<p>No new notifications.</p>';
    });

    document.querySelectorAll('.sidebar-group-toggle').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        toggle.closest('.sidebar-group')?.classList.toggle('is-collapsed', expanded);
      });
    });

    const state = document.getElementById('task-state');
    const showState = (message, type = '') => {
      if (!state) return;
      state.className = `task-state ${type}`;
      state.textContent = message;
    };

    const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[character]);
    const dashboardBento = document.getElementById('dashboard-bento-content');
    const dashboardRetry = document.getElementById('dashboard-retry');
    const dashboardValue = (value) => value === 0 ? '0' : value || 'No data available';
    const dashboardDate = (value) => value ? new Date(`${value}T00:00:00`).toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) : 'Date to be confirmed';
    const formatPeso = (value) => `₱${Number(value || 0).toLocaleString('en-PH', { maximumFractionDigits: 0 })}`;
    const formatWhen = (value) => value ? new Date(value).toLocaleString(undefined, { month: 'short', day: 'numeric' }) : '';
    const renderOwnerDashboard = (summary) => {
      const metrics = summary.metrics || {};
      const owner = summary.ownerMetrics || {};
      const trend = summary.trend || [];
      const maximum = Math.max(...trend.map((item) => item.count), 1);
      const trendBars = trend.length
        ? trend.map((item) => `<div class="trend-bar" title="${item._id}: ${item.count} appointment${item.count === 1 ? '' : 's'}"><span style="height: ${(item.count / maximum) * 100}%"></span><small>${dashboardDate(item._id)}</small></div>`).join('')
        : '<p class="bento-empty">No appointment data for this period.</p>';
      const upcomingRows = (summary.upcomingAppointments || []).slice(0, 4).map((appointment) => `<li><span><strong>${escapeHtml(appointment.preferredTime || 'TBD')}</strong><small>${escapeHtml(appointment.name || appointment.service)}</small></span><time>${dashboardDate(appointment.preferredDate)}</time></li>`).join('');
      const alertRows = (owner.inventoryAlerts || []).map((item) => `<li><span><strong>${escapeHtml(item.name)}</strong><small>${escapeHtml(item.sku || 'No SKU')}</small></span><strong>${item.quantity}</strong></li>`).join('');
      const transactionRows = (owner.recentTransactions || []).map((item) => `<li><span><strong>${escapeHtml(item.method || 'Payment')}</strong><small>${formatWhen(item.createdAt)}</small></span><strong>${formatPeso(item.amount)}</strong></li>`).join('');
      const activityRows = (owner.recentActivity || []).map((item) => `<li><span><strong>${escapeHtml(item.action)}</strong><small>${escapeHtml(item.actor)}</small></span><time>${formatWhen(item.createdAt)}</time></li>`).join('');
      const billing = owner.billing || {};
      dashboardBento.innerHTML = `
        <a class="bento-card bento-kpi" href="/dashboard/owner/manage-team"><span class="bento-label">Total Patients</span><strong class="bento-number">${dashboardValue(metrics.totalPatients)}</strong><span class="bento-meta">Registered</span></a>
        <a class="bento-card bento-kpi" href="/dashboard/owner/today-patients"><span class="bento-label">Today's Appointments</span><strong class="bento-number">${dashboardValue(owner.todayTotal ?? metrics.todayAppointments)}</strong><span class="bento-meta">Today</span></a>
        <a class="bento-card bento-kpi" href="/dashboard/owner/payment-history"><span class="bento-label">Today's Revenue</span><strong class="bento-number">${formatPeso(owner.todayRevenue)}</strong><span class="bento-meta">Today</span></a>
        <a class="bento-card bento-kpi" href="/dashboard/owner/inventory"><span class="bento-label">Low Stock Items</span><strong class="bento-number">${dashboardValue(owner.lowStockCount)}</strong><span class="bento-meta">Need attention</span></a>
        <section class="bento-card bento-card-billing">
          <div class="bento-card-heading"><span class="bento-label">Billing summary</span><a href="/dashboard/owner/billing-invoices">View invoices →</a></div>
          <div class="bento-billing-stats">
            <a href="/dashboard/owner/billing-invoices"><span>Total invoiced</span><strong>${formatPeso(billing.totalInvoiced)}</strong></a>
            <a href="/dashboard/owner/payment-history"><span>Payments collected</span><strong>${formatPeso(billing.totalCollected)}</strong></a>
            <a href="/dashboard/owner/outstanding-balances"><span>Outstanding</span><strong>${formatPeso(billing.outstanding)}</strong></a>
            <a href="/dashboard/owner/outstanding-balances"><span>Overdue</span><strong>${formatPeso(billing.overdueAmount)}</strong></a>
            <a href="/dashboard/owner/billing-invoices"><span>Paid invoices</span><strong>${dashboardValue(billing.paidInvoices)}</strong></a>
            <a href="/dashboard/owner/outstanding-balances"><span>Unpaid invoices</span><strong>${dashboardValue(billing.unpaidInvoices)}</strong></a>
          </div>
        </section>
        <section class="bento-card bento-card-appointments">
          <div class="bento-card-heading"><span class="bento-label">Today's Appointments</span><a href="/dashboard/owner/appointments">View all →</a></div>
          <strong class="bento-summary-total">${dashboardValue(owner.todayTotal ?? metrics.todayAppointments)} <span>total</span></strong>
          <ul class="bento-breakdown">
            <li><span>Completed</span><strong>${dashboardValue(metrics.completedToday)}</strong></li>
            <li><span>Pending</span><strong>${dashboardValue(owner.pendingToday)}</strong></li>
            <li><span>Cancelled</span><strong>${dashboardValue(owner.cancelledToday)}</strong></li>
          </ul>
          ${metrics.followUpsDue ? `<p class="bento-meta">${dashboardValue(metrics.followUpsDue)} follow-ups due</p>` : ''}
          ${upcomingRows ? `<ul class="bento-list">${upcomingRows}</ul>` : '<p class="bento-empty">No upcoming appointments.</p>'}
        </section>
        <section class="bento-card bento-card-alerts">
          <div class="bento-card-heading"><span class="bento-label">Inventory Alerts</span><a href="/dashboard/owner/inventory">View details →</a></div>
          <strong class="bento-summary-total">${dashboardValue(owner.lowStockCount)} <span>items</span></strong>
          <p class="bento-meta">Need attention</p>
          ${alertRows ? `<ul class="bento-list">${alertRows}</ul>` : '<p class="bento-empty">Stock levels look healthy.</p>'}
        </section>
        <section class="bento-card bento-card-chart">
          <div class="bento-card-heading"><span class="bento-label">Appointment Activity</span><a href="/dashboard/owner/reports">View reports →</a></div>
          <div class="trend-chart trend-chart-compact" role="img" aria-label="Appointment volume for the last seven days">${trendBars}</div>
        </section>
        <section class="bento-card bento-card-preview">
          <div class="bento-card-heading"><span class="bento-label">Recent Transactions</span><a href="/dashboard/owner/payment-history">View all →</a></div>
          <p class="bento-meta">Outstanding ${formatPeso(owner.outstandingBalance)}</p>
          ${transactionRows ? `<ul class="bento-list">${transactionRows}</ul>` : '<p class="bento-empty">No recent payments.</p>'}
        </section>
        <a class="bento-card bento-card-medium" href="/dashboard/owner/purchase-orders">
          <span class="bento-label">Supplier Activity</span>
          <strong class="bento-number">${dashboardValue(owner.pendingPurchaseOrders)}</strong>
          <span class="bento-meta">${dashboardValue(owner.activeSuppliers)} active suppliers</span>
        </a>
        <a class="bento-card bento-card-medium" href="/dashboard/owner/manage-team">
          <span class="bento-label">Staff Activity</span>
          <strong class="bento-number">${dashboardValue(owner.activeStaff)}</strong>
          <span class="bento-meta">Active clinic staff</span>
        </a>
        <section class="bento-card bento-card-preview bento-card-activity">
          <div class="bento-card-heading"><span class="bento-label">Recent Activity</span><a href="/dashboard/owner/audit-logs">View details →</a></div>
          ${activityRows ? `<ul class="bento-list">${activityRows}</ul>` : '<p class="bento-empty">No recent admin activity.</p>'}
        </section>`;
    };
    const renderDashboard = (summary) => {
      if (!dashboardBento) return;
      const metrics = summary.metrics || {};
      const isPatient = summary.role === 'patient';
      const appointmentRows = (summary.upcomingAppointments || []).map((appointment) => `<li><span><strong>${escapeHtml(appointment.preferredTime || 'Time pending')}</strong><small>${escapeHtml(appointment.service)}</small></span><time datetime="${escapeHtml(appointment.preferredDate)}">${dashboardDate(appointment.preferredDate)}</time></li>`).join('');
      if (isPatient) {
        dashboardBento.innerHTML = `
          <a class="bento-card bento-card-wide" href="/dashboard/${role}/appointments"><span class="bento-label">Upcoming appointment</span><strong class="bento-number">${appointmentRows ? escapeHtml(summary.upcomingAppointments[0].service) : 'No data available'}</strong><span class="bento-meta">${appointmentRows ? `${dashboardDate(summary.upcomingAppointments[0].preferredDate)} · ${escapeHtml(summary.upcomingAppointments[0].preferredTime || 'Time pending')}` : 'Book a visit when you are ready.'}</span></a>
          <a class="bento-card" href="/dashboard/${role}/appointments"><span class="bento-label">Appointments</span><strong class="bento-number">${dashboardValue(metrics.appointments)}</strong><span class="bento-meta">${dashboardValue(metrics.upcomingAppointments)} upcoming</span></a>
          <a class="bento-card" href="/dashboard/${role}/medical-records"><span class="bento-label">Clinical records</span><strong class="bento-number">${dashboardValue(metrics.clinicalRecords)}</strong><span class="bento-meta">Your care history</span></a>
          <a class="bento-card" href="/dashboard/${role}/follow-ups"><span class="bento-label">Follow-ups</span><strong class="bento-number">${dashboardValue(metrics.followUps)}</strong><span class="bento-meta">Open requests</span></a>
          <section class="bento-card bento-card-large"><div class="bento-card-heading"><span class="bento-label">Your next visits</span><a href="/dashboard/${role}/appointments">View all</a></div>${appointmentRows ? `<ul class="bento-list">${appointmentRows}</ul>` : '<p class="bento-empty">No upcoming appointments.</p>'}</section>
          <a class="bento-action" href="/dashboard/${role}/book-exam">Book an appointment <span aria-hidden="true">+</span></a>`;
        return;
      }
      if (role === 'owner') {
        renderOwnerDashboard(summary);
        return;
      }
      const trend = summary.trend || [];
      const maximum = Math.max(...trend.map((item) => item.count), 1);
      const trendBars = trend.length ? trend.map((item) => `<div class="trend-bar" title="${item._id}: ${item.count} appointment${item.count === 1 ? '' : 's'}"><span style="height: ${(item.count / maximum) * 100}%"></span><small>${dashboardDate(item._id)}</small></div>`).join('') : '<p class="bento-empty">No appointment data for this period.</p>';
      const operationsHref = role === 'eye-care-assistant' ? 'clinic-queue' : 'today-patients';
      const patientsHref = role === 'eye-care-assistant' ? 'patient-records' : 'today-patients';
      const statusCounts = (summary.statusCounts || []).map((item) => `<li><span>${escapeHtml(item._id)}</span><strong>${item.count}</strong></li>`).join('');
      const clinicalCards = role === 'optometrist' ? `<a class="bento-card" href="/dashboard/${role}/clinical-records"><span class="bento-label">Clinical records</span><strong class="bento-number">${dashboardValue(metrics.clinicalRecords)}</strong><span class="bento-meta">Records across the clinic</span></a>` : '';
      const followUpsDue = role === 'optometrist' ? `<div class="bento-stat-row"><strong>${dashboardValue(metrics.followUpsDue)}</strong><span>follow-ups due</span></div>` : '';
      dashboardBento.innerHTML = `
        <a class="bento-card" href="/dashboard/${role}/${operationsHref}"><span class="bento-label">Today\'s appointments</span><strong class="bento-number">${dashboardValue(metrics.todayAppointments)}</strong><span class="bento-meta">${dashboardValue(metrics.completedToday)} completed</span></a>
        <a class="bento-card" href="/dashboard/${role}/appointments"><span class="bento-label">Pending requests</span><strong class="bento-number">${dashboardValue(metrics.pendingAppointments)}</strong><span class="bento-meta">Review appointment status</span></a>
        <a class="bento-card" href="/dashboard/${role}/${patientsHref}"><span class="bento-label">Total patients</span><strong class="bento-number">${dashboardValue(metrics.totalPatients)}</strong><span class="bento-meta">Registered patient accounts</span></a>
        ${clinicalCards}
        <section class="bento-card bento-card-large"><div class="bento-card-heading"><span class="bento-label">Appointment activity</span><span class="bento-meta">Last 7 days</span></div><div class="trend-chart" role="img" aria-label="Appointment volume for the last seven days">${trendBars}</div></section>
        <section class="bento-card"><div class="bento-card-heading"><span class="bento-label">Appointment status</span><a href="/dashboard/${role}/appointments">Details</a></div>${statusCounts ? `<ul class="bento-status-list">${statusCounts}</ul>` : '<p class="bento-empty">No data available.</p>'}</section>
        <section class="bento-card"><div class="bento-card-heading"><span class="bento-label">Today\'s operations</span><a href="/dashboard/${role}/${operationsHref}">Open</a></div><div class="bento-stat-row"><strong>${dashboardValue(metrics.todayAppointments)}</strong><span>active appointments</span></div><div class="bento-stat-row"><strong>${dashboardValue(metrics.completedToday)}</strong><span>completed today</span></div>${followUpsDue}</section>
        <section class="bento-card bento-card-upcoming"><div class="bento-card-heading"><span class="bento-label">Upcoming appointments</span><a href="/dashboard/${role}/appointments">View all</a></div>${appointmentRows ? `<ul class="bento-list">${appointmentRows}</ul>` : '<p class="bento-empty">No upcoming appointments.</p>'}</section>`;
    };
    const loadDashboard = async () => {
      if (!dashboardBento || section !== 'dashboard') return;
      dashboardRetry.hidden = true;
      dashboardBento.innerHTML = '<div class="bento-loading" aria-label="Loading dashboard analytics"><span></span><span></span><span></span><span></span></div>';
      try {
        const response = await fetch(`${api}/api/workspace/dashboard-summary`, { headers: { Authorization: `Bearer ${token}` } });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to load analytics.');
        renderDashboard(result);
      } catch {
        dashboardBento.innerHTML = '<div class="bento-error"><strong>Unable to load analytics.</strong><span>Try again to refresh this overview.</span></div>';
        dashboardRetry.hidden = false;
      }
    };
    dashboardRetry?.addEventListener('click', loadDashboard);
    loadDashboard();
    const appointmentList = document.getElementById('appointment-list') || document.getElementById('today-patient-list');
    const appointmentSearch = document.getElementById('appointment-search') || document.getElementById('today-patient-search');
    const appointmentStatusFilter = document.getElementById('appointment-status-filter') || document.getElementById('today-patient-status');
    const appointmentDateFilter = document.getElementById('appointment-date-filter') || document.getElementById('today-patient-date');
    const appointmentPagination = document.getElementById('appointment-pagination') || document.getElementById('today-patient-pagination');
    const appointmentCalendarGrid = document.getElementById('appointment-calendar-grid');
    const appointmentCalendarMonth = document.getElementById('appointment-calendar-month');
    let appointments = [];
    let appointmentPage = 1;
    const pageSize = 5;

    if (section === 'today-patients' && appointmentDateFilter) appointmentDateFilter.value = new Date().toISOString().slice(0, 10);

    const appointmentActions = (appointment) => {
      if (role === 'patient') return '<span class="appointment-action-empty">-</span>';
      const actions = {
        pending: [['confirmed', 'Confirm patient'], ['cancelled', 'Reject']],
        confirmed: [['completed', 'Mark completed'], ['rescheduled', 'Reschedule'], ['cancelled', 'Cancel']],
        rescheduled: [['confirmed', 'Confirm patient'], ['cancelled', 'Reject']],
      }[appointment.status] || [];
      if (appointment.status === 'completed' || appointment.status === 'cancelled') return `<a class="btn btn-secondary appointment-action-link" href="/dashboard/${role}/clinical-records">View</a><a class="btn btn-secondary appointment-action-link" href="/dashboard/${role}/clinical-records">View Clinical Record</a>${appointment.status === 'cancelled' ? '<button type="button" class="btn btn-secondary appointment-action action-rescheduled" data-appointment-id="' + escapeHtml(appointment._id) + '" data-status="rescheduled">Reschedule</button>' : ''}`;
      return actions.map(([status, label]) => `<button type="button" class="btn btn-secondary appointment-action action-${status}" data-appointment-id="${escapeHtml(appointment._id)}" data-status="${status}">${label}</button>`).join('');
    };

    const renderAppointmentPage = () => {
      const query = (appointmentSearch?.value || '').toLowerCase().trim();
      const status = appointmentStatusFilter?.value || '';
      const date = appointmentDateFilter?.value || '';
      const filtered = appointments.filter((item) => (!status || item.status === status) && (!date || item.preferredDate === date) && (!query || `${item.name} ${item.email} ${item.service}`.toLowerCase().includes(query)));
      const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
      appointmentPage = Math.min(appointmentPage, pages);
      const visible = filtered.slice((appointmentPage - 1) * pageSize, appointmentPage * pageSize);
      appointmentList.innerHTML = visible.length ? `<div class="appointment-table-wrap"><table class="appointment-table"><thead><tr><th scope="col">Examination / Appointment</th><th scope="col">Patient</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead><tbody>${visible.map((item) => `<tr><td data-label="Examination / Appointment"><strong>${escapeHtml(item.service)}</strong></td><td data-label="Patient"><strong>${escapeHtml(item.name)}</strong><small>${escapeHtml(item.email)}</small></td><td data-label="Date">${escapeHtml(item.preferredDate || 'Date to be confirmed')}</td><td data-label="Status"><span class="appointment-status status-${escapeHtml(item.status)}">${escapeHtml(item.status)}</span></td><td data-label="Actions"><div class="appointment-actions">${appointmentActions(item)}</div></td></tr>`).join('')}</tbody></table></div>` : '<p class="empty-appointments">No appointments match these filters.</p>';
      appointmentPagination.innerHTML = pages > 1 ? `<button type="button" class="btn btn-secondary" data-page="prev" ${appointmentPage === 1 ? 'disabled' : ''}>Previous</button><span>Page ${appointmentPage} of ${pages}</span><button type="button" class="btn btn-secondary" data-page="next" ${appointmentPage === pages ? 'disabled' : ''}>Next</button>` : '';
      appointmentPagination.querySelector('[data-page="prev"]')?.addEventListener('click', () => { appointmentPage -= 1; renderAppointmentPage(); });
      appointmentPagination.querySelector('[data-page="next"]')?.addEventListener('click', () => { appointmentPage += 1; renderAppointmentPage(); });
      appointmentList.querySelectorAll('.appointment-action').forEach((button) => button.addEventListener('click', async () => {
        button.disabled = true;
        const response = await fetch(`${api}/api/appointments/${button.dataset.appointmentId}/status`, { method: 'PATCH', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ status: button.dataset.status }) });
        if (!response.ok) { button.disabled = false; return; }
        appointments = appointments.map((item) => item._id === button.dataset.appointmentId ? { ...item, status: button.dataset.status } : item);
        renderAppointmentPage();
      }));
    };

    let appointmentCalendarCursor = new Date();
    const renderAppointmentCalendar = () => {
      if (!appointmentCalendarGrid || !appointmentCalendarMonth) return;
      const year = appointmentCalendarCursor.getFullYear();
      const month = appointmentCalendarCursor.getMonth();
      const appointmentDates = new Set(appointments.map((item) => item.preferredDate).filter(Boolean));
      appointmentCalendarMonth.textContent = appointmentCalendarCursor.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
      appointmentCalendarGrid.innerHTML = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((day) => `<span class="calendar-label">${day}</span>`).join('');
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      for (let index = 0; index < firstDay; index += 1) appointmentCalendarGrid.insertAdjacentHTML('beforeend', '<span class="calendar-day empty"></span>');
      for (let day = 1; day <= daysInMonth; day += 1) {
        const date = new Date(year, month, day);
        const value = isoDate(date);
        const selected = appointmentDateFilter?.value === value;
        const hasAppointments = appointmentDates.has(value);
        appointmentCalendarGrid.insertAdjacentHTML('beforeend', `<button type="button" class="calendar-day ${selected ? 'selected' : ''} ${hasAppointments ? 'has-appointments' : ''}" data-appointment-calendar-date="${value}">${day}</button>`);
      }
      appointmentCalendarGrid.querySelectorAll('[data-appointment-calendar-date]').forEach((button) => button.addEventListener('click', () => {
        appointmentDateFilter.value = button.dataset.appointmentCalendarDate;
        appointmentPage = 1;
        renderAppointmentCalendar();
        renderAppointmentPage();
      }));
    };

    document.getElementById('appointment-calendar-prev')?.addEventListener('click', () => { appointmentCalendarCursor.setMonth(appointmentCalendarCursor.getMonth() - 1); renderAppointmentCalendar(); });
    document.getElementById('appointment-calendar-next')?.addEventListener('click', () => { appointmentCalendarCursor.setMonth(appointmentCalendarCursor.getMonth() + 1); renderAppointmentCalendar(); });

    if (appointmentList) {
      const endpoint = role === 'patient' ? '/api/appointments/mine' : '/api/appointments';
      fetch(`${api}${endpoint}`, { headers: { Authorization: `Bearer ${token}` } })
        .then(async (response) => { const result = await response.json(); if (!response.ok) throw new Error(result.message); return result; })
        .then((result) => {
          showState(`${result.appointments?.length || 0} appointment${result.appointments?.length === 1 ? '' : 's'} found.`, 'success');
          appointments = result.appointments || [];
          renderAppointmentCalendar();
          renderAppointmentPage();
        })
        .catch((error) => { showState(error.message || 'Unable to load appointments.', 'error'); appointmentList.innerHTML = '<p class="empty-appointments">Try again when the clinic API is available.</p>'; });
    } else if (section !== 'book-exam' && section !== 'manage-team') {
      showState('Workspace ready. No records require attention right now.', 'success');
    }

    [appointmentSearch, appointmentStatusFilter, appointmentDateFilter].forEach((control) => control?.addEventListener('input', () => { appointmentPage = 1; renderAppointmentCalendar(); renderAppointmentPage(); }));

    const bookingForm = document.getElementById('booking-workflow');
    const bookingReview = document.getElementById('booking-review');
    const bookingStatus = document.getElementById('booking-status');
    const workflowDate = document.getElementById('workflow-date');
    const workflowTime = document.getElementById('workflow-time');
    const calendarGrid = document.getElementById('calendar-grid');
    const calendarMonth = document.getElementById('calendar-month');
    let calendarCursor = new Date();
    let selectedDate = '';

    const isoDate = (date) => {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const loadAvailability = async (date) => {
      if (!workflowTime) return;
      workflowTime.innerHTML = '<option value="">Loading available times...</option>';
      try {
        const response = await fetch(`${api}/api/appointments/availability?date=${date}`);
        const result = await response.json();
        workflowTime.innerHTML = result.slots?.some((slot) => slot.available)
          ? '<option value="">Select a time</option>' + result.slots.map((slot) => `<option value="${slot.time}" ${slot.available ? '' : 'disabled'}>${slot.time}${slot.available ? '' : ' - booked'}</option>`).join('')
          : '<option value="">No times available</option>';
      } catch {
        workflowTime.innerHTML = '<option value="">Availability unavailable</option>';
      }
    };

    const renderCalendar = () => {
      if (!calendarGrid || !calendarMonth) return;
      const year = calendarCursor.getFullYear();
      const month = calendarCursor.getMonth();
      calendarMonth.textContent = calendarCursor.toLocaleDateString(undefined, { month: 'long', year: 'numeric' });
      calendarGrid.innerHTML = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((day) => `<span class="calendar-label">${day}</span>`).join('');
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      for (let index = 0; index < firstDay; index += 1) calendarGrid.insertAdjacentHTML('beforeend', '<span class="calendar-day empty"></span>');
