                <div class="field-row"><div class="field-group"><label for="record-patient">Patient ID</label><input id="record-patient" name="patientId" placeholder="HME-000127" pattern="HME-[0-9]{6}" required /></div><div class="field-group"><label for="record-title">Title</label><input id="record-title" name="title" required /></div></div>
                <div class="field-group"><label for="record-details">Clinical encounter details</label><textarea id="record-details" name="details" rows="7" placeholder="Chief complaint, history, eye examination, assessment, clinical notes, treatment recommendations, and follow-up plan" required></textarea></div>
                <button type="submit" class="btn btn-primary">Save {section === 'consultations' ? 'consultation' : 'prescription'}</button><p id="record-status" class="form-status" aria-live="polite"></p>
              </form>}
              {section === 'clinical-records' && <div class="list-toolbar"><input id="clinical-record-search" type="search" placeholder="Search patient, diagnosis, or record" aria-label="Search clinical records" /></div>}
              <div id="clinical-record-list" class="record-list"><p class="empty-appointments">Loading records...</p></div>
            </div>
          )}

          {section === 'roles-permissions' && role === 'owner' && <div id="permissions-list" class="record-list"><p class="empty-appointments">Loading permissions...</p></div>}

          {section === 'audit-logs' && role === 'owner' && (
            <div class="workflow-list">
              <div class="list-toolbar"><input id="audit-search" type="search" placeholder="Search Performed By, action, or patient" /><select id="audit-module-filter"><option value="">All modules</option><option value="appointments">Appointment Management</option><option value="administration">Clinic Administration</option></select><input id="audit-date-filter" type="date" aria-label="Filter audit logs by date" /></div>
              <div class="audit-legend" aria-label="Audit action colors"><span><i class="audit-legend-dot audit-positive"></i>Created</span><span><i class="audit-legend-dot audit-warning"></i>Changed</span><span><i class="audit-legend-dot audit-danger"></i>Removed</span></div>
              <div id="audit-log-list" class="record-list"><p class="empty-appointments">Loading audit logs...</p></div>
              <div id="audit-pagination" class="pagination" aria-label="Audit log pages"></div>
              <dialog id="audit-detail-modal" class="audit-detail-modal"><div class="audit-detail-modal-header"><h2 id="audit-detail-title">Audit details</h2><button type="button" class="btn btn-secondary audit-detail-close-button" id="audit-detail-close" aria-label="Close audit details" title="Close">X</button></div><div id="audit-detail-content"></div></dialog>
            </div>
          )}

          {section === 'clinic-settings' && role === 'owner' && (
            <form id="clinic-settings-form" class="workflow-form"><div class="field-group"><label for="clinic-name">Clinic name</label><input id="clinic-name" name="name" required /></div><div class="field-row"><div class="field-group"><label for="clinic-phone">Phone</label><input id="clinic-phone" name="phone" /></div><div class="field-group"><label for="clinic-email">Email</label><input id="clinic-email" name="email" type="email" /></div></div><div class="field-group"><label for="clinic-address">Address</label><input id="clinic-address" name="address" /></div><div class="field-group"><label for="clinic-hours">Hours</label><input id="clinic-hours" name="hours" /></div><button type="submit" class="btn btn-primary">Save clinic settings</button><p id="settings-status" class="form-status" aria-live="polite"></p></form>
          )}

          {section !== 'dashboard' && section !== 'book-exam' && section !== 'appointments' && section !== 'today-patients' && section !== 'follow-ups' && section !== 'profile' && !['medical-records', 'prescriptions', 'clinical-records', 'consultations', 'manage-team', 'manage-users', 'roles-permissions', 'audit-logs', 'clinic-settings', 'suppliers', 'purchase-orders', 'receiving', 'purchase-history', 'inventory', 'stock-movements', 'stock-in', 'stock-out', 'stock-adjustment', 'inventory-history', 'billing-invoices', 'invoice-templates', 'customer-payments', 'payment-history', 'outstanding-balances'].includes(section) && (
            <div class="task-grid">
              {role !== 'owner' && <><article class="task-summary-card"><span>Access scope</span><strong>{role === 'patient' ? 'Personal records only' : role === 'optometrist' ? 'Authorized clinical care' : role === 'eye-care-assistant' ? 'Clinic operations' : 'Clinic administration and clinical care'}</strong><small>Protected by role permissions</small></article><article class="task-summary-card"><span>Current state</span><strong>Ready to review</strong><small>Use this workspace for {pageTitle.toLowerCase()}</small></article></>}
              <div class="empty-state task-empty"><h2>No records loaded yet</h2><p>Connect this workspace to clinic records as activity becomes available.</p></div>
            </div>
