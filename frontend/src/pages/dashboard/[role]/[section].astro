---
import Layout from '../../../layouts/Layout.astro';
import SidebarIcon from '../../../components/SidebarIcon.astro';
import InvoiceTemplateBuilder from '../../../components/InvoiceTemplateBuilder.astro';

const { role, section } = Astro.params;
const iconPaths = {
  dashboard: 'M4 13h6V4H4v9Zm0 7h6v-4H4v4Zm10 0h6v-9h-6v9Zm0-16v4h6V4h-6Z',
  'book-exam': 'M6 3h12v18H6V3Zm3 0v4h6V3M9 12h6m-6 4h4',
  appointments: 'M7 3v3m10-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13H4V6a1 1 0 0 1 1-1Z',
  'follow-ups': 'M4 12a8 8 0 1 0 2-5m-2 0V3m0 4h4',
  'medical-records': 'M6 3h9l3 3v15H6V3Zm9 0v4h3M9 12h6m-6 4h4',
  prescriptions: 'M7 3h10v18H7V3Zm3 4h4m-4 4h4m-4 4h3',
  notifications: 'M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4',
  profile: 'M20 21a8 8 0 0 0-16 0m12-13a4 4 0 1 1-8 0 4 4 0 0 0 8 0Z',
  'today-patients': 'M4 5h16v14H4V5Zm4 4h8m-8 4h5',
  consultations: 'M5 4h14v16H5V4Zm3 4h8m-8 4h8m-8 4h5',
  'clinical-records': 'M6 3h9l3 3v15H6V3Zm9 0v4h3M9 12h6m-6 4h4',
  'clinic-queue': 'M4 6h16M4 12h16M4 18h16M8 6v12',
  'check-in': 'M5 4h14v16H5V4Zm3 4h8m-8 4h8m-8 4h5',
  'patient-records': 'M4 5h16v14H4V5Zm3 4h10m-10 4h7',
  billing: 'M6 3h12v18H6V3Zm3 5h6m-6 4h6m-6 4h4',
  reports: 'M5 20V10m7 10V4m7 16v-7',
  'manage-team': 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m8-10a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm6-3a4 4 0 0 1 0-7.75M22 21v-2a4 4 0 0 0-3-3.87',
  'manage-users': 'M4 5h16v14H4V5Zm3 4h10m-10 4h7',
  'roles-permissions': 'M12 3 20 7v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4Zm-3 9 2 2 4-4',
  'audit-logs': 'M6 3h12v18H6V3Zm3 4h6m-6 4h6m-6 4h4',
  'clinic-settings': 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0-5v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.42 1.42M7.06 16.94l-1.42 1.42m12.72 0-1.42-1.42M7.06 7.06 5.64 5.64',
};

const navigation = {
  patient: {
    dashboard: 'Patient Dashboard',
    'book-exam': 'Book an Appointment',
    appointments: 'Appointments',
    'follow-ups': 'Follow-ups',
    'medical-records': 'Medical Records',
    prescriptions: 'Prescriptions',
    notifications: 'Notifications',
    profile: 'Profile',
  },
  optometrist: {
    dashboard: 'Optometrist Dashboard',
    'today-patients': "Today's Patients",
    appointments: 'Appointments',
    consultations: 'Consultations',
    'clinical-records': 'Clinical Records',
    prescriptions: 'Prescriptions',
    'follow-ups': 'Follow-ups',
  },
  'eye-care-assistant': {
    dashboard: 'Eye Care Assistant Dashboard',
    'check-in': 'Patient Check-In',
    appointments: 'Appointments',
    'clinic-queue': 'Clinic Queue',
    'patient-records': 'Patient Records',
    billing: 'Billing',
  },
  owner: {
    dashboard: 'Owner Dashboard',
    'today-patients': "Today's Patients",
    appointments: 'Appointments',
    consultations: 'Consultations',
    'clinical-records': 'Clinical Records',
    prescriptions: 'Prescriptions',
    'follow-ups': 'Follow-ups',
    'manage-team': "User's Management",
    'manage-users': 'Manage Users',
    'roles-permissions': 'Roles & Permissions',
    'audit-logs': 'Audit Logs',
    reports: 'Reports',
    'clinic-settings': 'Clinic Settings',
    suppliers: 'Suppliers',
    'purchase-orders': 'Purchase Orders',
    receiving: 'Receiving',
    'purchase-history': 'Purchase History',
    inventory: 'Inventory',
    'stock-movements': 'Stock Movements',
    'stock-in': 'Stock In',
    'stock-out': 'Stock Out',
    'stock-adjustment': 'Stock Adjustment',
    'inventory-history': 'Inventory History',
    'billing-invoices': 'Billing / Invoices',
    'invoice-templates': 'Invoice Templates',
    'customer-payments': 'Customer Payments',
    'payment-history': 'Payment History',
    'outstanding-balances': 'Outstanding Balances',
  },
};

const sidebarGroups = {
  patient: [['Overview', ['dashboard']], ['Care', ['book-exam', 'appointments', 'follow-ups', 'medical-records', 'prescriptions']], ['Account', ['notifications', 'profile']]],
  optometrist: [['Overview', ['dashboard', 'today-patients']], ['Clinical Work', ['today-patients', 'appointments', 'consultations', 'clinical-records', 'prescriptions', 'follow-ups']]],
  'eye-care-assistant': [['Overview', ['dashboard', 'clinic-queue']], ['Operations', ['check-in', 'appointments', 'patient-records', 'billing']]],
  owner: [['Overview', ['dashboard', 'reports']], ['Clinical Work', ['today-patients', 'appointments', 'consultations', 'clinical-records', 'prescriptions', 'follow-ups']], ['Management', ['manage-team', 'roles-permissions']], ['Supplier Transactions', ['suppliers', 'purchase-orders', 'receiving', 'purchase-history']], ['Inventory', ['inventory', 'stock-movements', 'stock-adjustment', 'inventory-history']], ['Billing', ['billing-invoices', 'invoice-templates', 'customer-payments', 'payment-history', 'outstanding-balances']], ['Monitoring & Settings', ['audit-logs', 'clinic-settings']]],
};
const groupIcons = {
  Overview: 'overview',
  Care: 'care',
  Account: 'account',
  'Clinical Work': 'clinical-work',
  Operations: 'operations',
  Management: 'management',
  'Monitoring & Settings': 'monitoring-settings',
  'Supplier Transactions': 'supplier-transactions',
  Inventory: 'inventory',
  'Stock Movements': 'inventory',
  Billing: 'billing',
};

const roleNavigation = navigation[role] || {};
const pageTitle = roleNavigation[section] || 'Workspace';
const isValidRoute = Boolean(roleNavigation[section]);

const routePairs = [
  ['patient', 'dashboard'], ['patient', 'book-exam'], ['patient', 'appointments'], ['patient', 'follow-ups'], ['patient', 'medical-records'], ['patient', 'prescriptions'], ['patient', 'notifications'], ['patient', 'profile'],
  ['optometrist', 'dashboard'], ['optometrist', 'today-patients'], ['optometrist', 'appointments'], ['optometrist', 'consultations'], ['optometrist', 'clinical-records'], ['optometrist', 'prescriptions'], ['optometrist', 'follow-ups'],
  ['eye-care-assistant', 'dashboard'], ['eye-care-assistant', 'check-in'], ['eye-care-assistant', 'appointments'], ['eye-care-assistant', 'clinic-queue'], ['eye-care-assistant', 'patient-records'], ['eye-care-assistant', 'billing'],
  ['owner', 'dashboard'], ['owner', 'today-patients'], ['owner', 'appointments'], ['owner', 'consultations'], ['owner', 'clinical-records'], ['owner', 'prescriptions'], ['owner', 'follow-ups'], ['owner', 'manage-team'], ['owner', 'manage-users'], ['owner', 'roles-permissions'], ['owner', 'suppliers'], ['owner', 'purchase-orders'], ['owner', 'receiving'], ['owner', 'purchase-history'], ['owner', 'inventory'], ['owner', 'stock-movements'], ['owner', 'stock-in'], ['owner', 'stock-out'], ['owner', 'stock-adjustment'], ['owner', 'inventory-history'], ['owner', 'billing-invoices'], ['owner', 'invoice-templates'], ['owner', 'customer-payments'], ['owner', 'payment-history'], ['owner', 'outstanding-balances'], ['owner', 'audit-logs'], ['owner', 'reports'], ['owner', 'clinic-settings'],
];

export function getStaticPaths() {
  return [
    ['patient', 'dashboard'], ['patient', 'book-exam'], ['patient', 'appointments'], ['patient', 'follow-ups'], ['patient', 'medical-records'], ['patient', 'prescriptions'], ['patient', 'notifications'], ['patient', 'profile'],
    ['optometrist', 'dashboard'], ['optometrist', 'today-patients'], ['optometrist', 'appointments'], ['optometrist', 'consultations'], ['optometrist', 'clinical-records'], ['optometrist', 'prescriptions'], ['optometrist', 'follow-ups'],
    ['eye-care-assistant', 'dashboard'], ['eye-care-assistant', 'check-in'], ['eye-care-assistant', 'appointments'], ['eye-care-assistant', 'clinic-queue'], ['eye-care-assistant', 'patient-records'], ['eye-care-assistant', 'billing'],
    ['owner', 'dashboard'], ['owner', 'today-patients'], ['owner', 'appointments'], ['owner', 'consultations'], ['owner', 'clinical-records'], ['owner', 'prescriptions'], ['owner', 'follow-ups'], ['owner', 'manage-team'], ['owner', 'manage-users'], ['owner', 'roles-permissions'], ['owner', 'suppliers'], ['owner', 'purchase-orders'], ['owner', 'receiving'], ['owner', 'purchase-history'], ['owner', 'inventory'], ['owner', 'stock-movements'], ['owner', 'stock-in'], ['owner', 'stock-out'], ['owner', 'stock-adjustment'], ['owner', 'inventory-history'], ['owner', 'billing-invoices'], ['owner', 'invoice-templates'], ['owner', 'customer-payments'], ['owner', 'payment-history'], ['owner', 'outstanding-balances'], ['owner', 'audit-logs'], ['owner', 'reports'], ['owner', 'clinic-settings'],
  ].map(([routeRole, routeSection]) => ({ params: { role: routeRole, section: routeSection } }));
}

const pageCopy = {
  dashboard: 'A focused overview of today\'s work, priorities, and activity.',
  'book-exam': 'Choose a service, preferred date, and available time for your visit.',
  appointments: 'Review upcoming and previous visits, status, and appointment details.',
  'follow-ups': 'Request a follow-up visit and track its progress with the clinic team.',
  'medical-records': 'Review your examination and consultation history.',
  prescriptions: 'View prescriptions shared with your account.',
  notifications: 'Appointment reminders, confirmations, prescription updates, and clinic notices.',
  profile: 'Keep your personal, contact, and account information up to date.',
  'today-patients': 'See today\'s schedule and open the next consultation workspace.',
  consultations: 'Record examination findings, diagnosis, notes, prescriptions, and follow-up plans.',
  'clinical-records': 'Search and review a patient\'s longitudinal consultations, findings, diagnoses, notes, prescriptions, and follow-up history.',
  'follow-ups': 'Track upcoming, due, completed, and missed follow-up care.',
  'check-in': 'Find an arriving patient, verify the visit, and add them to the queue.',
  'clinic-queue': 'Monitor the live queue and update each patient\'s operational status.',
  'patient-records': 'Search registration and contact information without exposing restricted clinical data.',
  billing: 'Review charges, payment status, invoices, and transaction history.',
  'manage-team': 'Create staff accounts, review users, and manage access from one protected workspace.',
  'manage-users': 'Search accounts, filter by role and status, and manage user access.',
  'roles-permissions': 'Review which modules each role can access and adjust permissions.',
  'audit-logs': 'Review administrative, access, appointment, and record activity.',
  reports: 'Review appointment, patient, consultation, and billing summaries.',
  'clinic-settings': 'Configure clinic identity, hours, services, schedules, and closed dates.',
  suppliers: 'Manage clinic suppliers and supplier contact information.',
  'purchase-orders': 'Prepare and review purchase orders for clinic supplies.',
  receiving: 'Record incoming products and supplies received from suppliers.',
  'purchase-history': 'Review completed supplier purchases and receiving history.',
  inventory: 'Review current product and supply inventory levels.',
  'stock-movements': 'Record and review stock added to or removed from inventory.',
  'stock-in': 'Record products and supplies added to inventory.',
  'stock-out': 'Record products and supplies issued or removed from inventory.',
  'stock-movements': 'Record products and supplies added to or removed from inventory.',
  'stock-adjustment': 'Record corrections to inventory quantities and reasons.',
  'inventory-history': 'Review inventory movements and adjustment history.',
  'billing-invoices': 'Review patient and customer bills, invoices, services, and products.',
  'invoice-templates': 'Design reusable invoice documents with dynamic customer, invoice, and payment data.',
  'customer-payments': 'Record payments against patient or customer invoices.',
  'payment-history': 'Review payment dates, methods, amounts, and related invoices.',
  'outstanding-balances': 'Review unpaid invoices and remaining patient or customer balances.',
};

const copy = pageCopy[section] || 'This workspace is ready for your clinic workflow.';
---

<Layout title={`${pageTitle} | HM VisionSync`}>
  <main class="dashboard-page dashboard-layout">
    <button class="mobile-sidebar-toggle" type="button" id="mobile-sidebar-toggle" aria-label="Open dashboard navigation" aria-expanded="false" title="Open dashboard navigation"><SidebarIcon name="panel-left" /></button>
    <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>
    <aside class={`dashboard-sidebar ${role === 'owner' ? 'owner-sidebar' : ''}`}>
      <div class="sidebar-header">
        <a class="sidebar-brand" href={`/dashboard/${role}/dashboard`}>HM VisionSync</a>
        <button class="sidebar-collapse-toggle" type="button" id="sidebar-collapse-toggle" aria-label="Collapse sidebar" aria-expanded="true" title="Collapse sidebar"><SidebarIcon name="panel-left" /></button>
      </div>
      <span class="sidebar-role">{role} workspace</span>
      {role !== 'owner' && (
        <div class="sidebar-identity" aria-label="Account identifier">
          <span id="sidebar-id-label">{role === 'patient' ? 'Patient ID' : 'User ID'}</span>
          <strong id="sidebar-user-id">Loading...</strong>
        </div>
      )}
      <nav class="sidebar-groups" aria-label="Dashboard navigation">
        {(sidebarGroups[role] || []).map(([groupLabel, groupSections]) => {
          const isExpanded = role === 'owner' && groupLabel === 'Clinical Work' || groupSections.includes(section);
          return (
          <div class={`sidebar-group ${isExpanded ? '' : 'is-collapsed'}`}>
            <button class="sidebar-group-toggle" type="button" aria-expanded={isExpanded ? 'true' : 'false'}>
              <SidebarIcon name={groupIcons[groupLabel]} /><span>{groupLabel}</span><span class="sidebar-chevron" aria-hidden="true">⌄</span>
            </button>
            <div class="sidebar-group-links">
              {groupSections.map((routeSection) => (
                <a class={routeSection === section ? 'is-current' : ''} href={`/dashboard/${role}/${routeSection}`}>
                  <SidebarIcon name={routeSection} /><span>{roleNavigation[routeSection]}</span>
                </a>
              ))}
            </div>
          </div>
          );
        })}
      </nav>
      <div class="sidebar-divider" aria-hidden="true"></div>
      <span class="sidebar-section-label">Account</span>
      <nav class="sidebar-nav sidebar-account-nav">
        <a href="#" id="sidebar-logout"><SidebarIcon name="signout" /><span>Sign out</span></a>
      </nav>
      <a class="sidebar-home" href="/"><SidebarIcon name="home" /><span>Back to clinic site</span></a>
    </aside>

    <div class={`dashboard-main ${role === 'owner' && section === 'dashboard' ? 'owner-dashboard-main' : ''}`}>
      <section class="dashboard-header container">
        <div>
          <span class="eyebrow">{role} workspace</span>
          <h1>{pageTitle}</h1>
          <p class="breadcrumb">Dashboard / {pageTitle}</p>
        </div>
        <div class="dashboard-header-actions">
          <button type="button" class="notification-button" id="notification-button" aria-label="Open notifications" aria-expanded="false" title="Notifications">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg><span id="notification-count" class="notification-count" hidden></span>
          </button>
          <a href={`/dashboard/${role}/dashboard`} class="btn btn-secondary">Overview</a>
          <div class="notification-popover" id="notification-popover" hidden><strong>Notifications</strong><div id="notification-list"><p>Loading notifications...</p></div></div>
        </div>
      </section>

      {isValidRoute && (
        section === 'dashboard' ? (
          <>
            <section class={`container dashboard-bento ${role === 'owner' ? 'owner-dashboard-bento' : ''}`} id="dashboard-bento" data-role={role}>
              <div class="bento-heading">
                <div>
                  <span class="eyebrow">Live overview</span>
                  <h2>{role === 'owner' ? 'Clinic overview' : copy}</h2>
                </div>
                <button class="btn btn-secondary" type="button" id="dashboard-retry" hidden>Try again</button>
              </div>
              <div id="dashboard-bento-content" class={`bento-grid ${role === 'owner' ? 'owner-bento-grid' : ''}`} aria-live="polite">
                <div class="bento-loading" aria-label="Loading dashboard analytics"><span></span><span></span><span></span><span></span></div>
              </div>
            </section>

            {role !== 'owner' && (
            <section class="container dashboard-appointments card" id="appointment-panel" hidden style="margin-top: 2rem;">
              <div class="section-header split">
                <div>
                  <h2 id="appointment-heading">Appointments</h2>
                </div>
              </div>
              <div class="list-toolbar">
                <input id="overview-appointment-search" type="search" placeholder="Search patient or service" />
                <select id="overview-appointment-status"><option value="">All statuses</option><option value="pending">Pending</option><option value="confirmed">Confirmed</option><option value="completed">Completed</option><option value="cancelled">Rejected</option><option value="rescheduled">Rescheduled</option><option value="no-show">No-show</option></select>
                <input id="overview-appointment-date" type="date" aria-label="Filter by appointment date" />
              </div>
              <div id="appointment-list" class="appointment-list"></div>
              <div id="overview-appointment-pagination" class="pagination" aria-label="Appointment pages"></div>
            </section>
            )}
          </>
        ) : (
          <section class="container task-page-card card">
            <p class="task-page-description">{copy}</p>
            <div class="task-state" id="task-state">
              <span class="loading-dot"></span>
              Loading workspace data...
            </div>

            {role === 'owner' && ['suppliers', 'purchase-orders', 'receiving', 'purchase-history', 'inventory', 'stock-movements', 'stock-in', 'stock-out', 'stock-adjustment', 'inventory-history'].includes(section) && (
              <div class="operation-workspace">
                {['stock-movements', 'stock-in', 'stock-out'].includes(section) && <nav class="stock-movement-tabs" aria-label="Stock movement type"><a class={section !== 'stock-out' ? 'is-current' : ''} href={`/dashboard/${role}/stock-movements`}>Stock In</a><a class={section === 'stock-out' ? 'is-current' : ''} href={`/dashboard/${role}/stock-out`}>Stock Out</a></nav>}
                {!['purchase-history', 'inventory-history', 'payment-history', 'outstanding-balances'].includes(section) && (
                  <form id="operation-form" class="workflow-form">
                    {section === 'suppliers' && <div class="field-row"><div class="field-group"><label for="operation-name">Supplier name</label><input id="operation-name" name="name" required /></div><div class="field-group"><label for="operation-contact">Contact person</label><input id="operation-contact" name="contactPerson" /></div></div>}
                    {section === 'suppliers' && <div class="field-row"><div class="field-group"><label for="operation-phone">Contact number</label><input id="operation-phone" name="phone" inputmode="tel" pattern="\+63 [0-9]{3}-[0-9]{3}-[0-9]{4}" maxlength="16" placeholder="+63 000-000-0000" /></div><div class="field-group"><label for="operation-email">Email</label><input id="operation-email" name="email" type="email" /></div></div>}
                    {section === 'suppliers' && <div class="field-row"><div class="field-group"><label for="operation-address">Address</label><input id="operation-address" name="address" /></div><div class="field-group"><label for="operation-status">Status</label><select id="operation-status" name="status"><option>active</option><option>inactive</option></select></div></div>}
                    {section === 'suppliers' && <div class="field-group"><label for="operation-products">Products supplied</label><textarea id="operation-products" name="products" rows="3"></textarea></div>}
                    {section === 'purchase-orders' && <div class="field-row"><div class="field-group"><label for="operation-supplier">Supplier name or ID</label><input id="operation-supplier" name="supplierName" required /></div><div class="field-group"><label for="operation-order-number">Purchase order number</label><input id="operation-order-number" name="orderNumber" required /></div></div>}
                    {section === 'purchase-orders' && <div class="field-row"><div class="field-group"><label for="operation-order-date">Order date</label><input id="operation-order-date" name="orderDate" type="date" required /></div><div class="field-group"><label for="operation-order-status">Order status</label><select id="operation-order-status" name="status"><option>draft</option><option>ordered</option><option>partially-received</option><option>received</option><option>cancelled</option></select></div></div>}
                    {['purchase-orders', 'receiving', 'stock-movements', 'stock-in', 'stock-out', 'stock-adjustment'].includes(section) && <div class="operation-items-editor"><div class="section-header split"><div><h3>Items</h3><p>Add each item and quantity for this transaction.</p></div><button type="button" class="btn btn-primary operation-add-item" id="add-operation-item">Add item</button></div><div class="appointment-table-wrap"><table class="appointment-table operation-items-table"><thead><tr><th scope="col">SKU</th><th scope="col">Quantity</th><th scope="col">Action</th></tr></thead><tbody id="operation-items-body"><tr><td><input name="itemSku" aria-label="Item SKU" placeholder="ITEM-001" required /></td><td><input name="itemQuantity" type="number" min="1" step="1" aria-label="Item quantity" required /></td><td><button type="button" class="btn btn-secondary remove-operation-item" aria-label="Remove item">Remove</button></td></tr></tbody></table></div></div>}
                    {section === 'receiving' && <div class="field-row"><div class="field-group"><label for="operation-reference">Receiving reference</label><input id="operation-reference" name="reference" required /></div><div class="field-group"><label for="operation-received-date">Receiving date</label><input id="operation-received-date" name="receivedDate" type="date" /></div></div>}
                    {section === 'receiving' && <div class="field-group"><label for="operation-purchase-order">Purchase order ID</label><input id="operation-purchase-order" name="purchaseOrderId" /></div>}
                    {section === 'inventory' && <div class="field-row"><div class="field-group"><label for="operation-name">Item name</label><input id="operation-name" name="name" required /></div><div class="field-group"><label for="operation-sku">SKU</label><input id="operation-sku" name="sku" required /></div></div>}
                    {section === 'inventory' && <div class="field-row"><div class="field-group"><label for="operation-quantity">Current quantity</label><input id="operation-quantity" name="quantity" type="number" min="0" required /></div><div class="field-group"><label for="operation-unit">Unit</label><input id="operation-unit" name="unit" placeholder="box, bottle, piece" /></div></div>}
                    {section === 'inventory' && <div class="field-row"><div class="field-group"><label for="operation-minimum">Minimum stock level</label><input id="operation-minimum" name="minimumStock" type="number" min="0" /></div><div class="field-group"><label for="operation-reorder">Reorder level</label><input id="operation-reorder" name="reorderLevel" type="number" min="0" /></div></div>}
                    {section === 'inventory' && <div class="field-row"><div class="field-group"><label for="operation-category">Category</label><input id="operation-category" name="category" /></div><div class="field-group"><label for="operation-cost">Cost</label><input id="operation-cost" name="cost" type="number" min="0" step="0.01" /></div></div>}
                    {section === 'inventory' && <div class="field-group"><label for="operation-selling-price">Selling price</label><input id="operation-selling-price" name="sellingPrice" type="number" min="0" step="0.01" /></div>}
                    {['stock-movements', 'stock-in', 'stock-out', 'stock-adjustment'].includes(section) && <div class="field-row"><div class="field-group"><label for="operation-movement-type">Movement type</label><select id="operation-movement-type" name="movementType"><option value="stock-in">Stock In</option><option value="stock-out">Stock Out</option></select></div><div class="field-group"><label for="operation-reason">Reason</label><input id="operation-reason" name="reason" required /></div><div class="field-group"><label for="operation-reference">Reference</label><input id="operation-reference" name="reference" /></div></div>}
                    <button type="submit" class="btn btn-primary">Save {pageTitle}</button>
                    <p id="operation-status" class="form-status" aria-live="polite"></p>
                  </form>
                )}
                <div id="operation-list" class="record-list"><p class="empty-appointments">Loading records...</p></div>
              </div>
            )}

            {role === 'owner' && ['billing-invoices', 'invoice-templates', 'customer-payments', 'payment-history', 'outstanding-balances'].includes(section) && (
              <div class="billing-workspace">
                {(section === 'billing-invoices' || section === 'invoice-templates') && (
                  <div class="billing-tabs-nav">
                    <button type="button" class={`billing-tab-btn ${section === 'billing-invoices' ? 'active' : ''}`} data-tab="invoices">Invoices & Billing</button>
                    <button type="button" class={`billing-tab-btn ${section === 'invoice-templates' ? 'active' : ''}`} data-tab="template">Template Design</button>
                  </div>
                )}

                <div id="billing-invoices-tab-content" style={(section === 'invoice-templates') ? 'display: none;' : 'display: block;'}>
