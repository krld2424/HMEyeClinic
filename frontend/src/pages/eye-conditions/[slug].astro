---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export function getStaticPaths() {
  const conditions = {
    astigmatism: {
      title: 'Astigmatism',
      description: 'Astigmatism is a common refractive error caused by an irregularly curved cornea or lens, which can make vision appear blurred or distorted at different distances.',
      article: true,
    },
    'dry-eye-syndrome': {
      title: 'Dry Eye Syndrome',
      description: 'Dry eye syndrome occurs when the eyes do not produce enough tears or when tears evaporate too quickly, often causing irritation, redness, fluctuating vision, or a gritty sensation.',
      articleType: 'dry-eye',
    },
    glaucoma: {
      title: 'Glaucoma',
      description: 'Glaucoma is a group of eye conditions that can damage the optic nerve. Regular eye examinations help identify risk factors and changes early.',
    },
    'hyperopia-farsightedness': {
      title: 'Hyperopia/Farsightedness',
      description: 'Hyperopia, or farsightedness, can make close-up objects appear less clear because the eye focuses images behind the retina.',
    },
    keratoconus: {
      title: 'Keratoconus',
      description: 'Keratoconus is a condition in which the cornea gradually becomes thinner and more cone-shaped, potentially causing blurred or distorted vision and increased sensitivity to light.',
    },
    'myopia-nearsightedness': {
      title: 'Myopia/Nearsightedness',
      description: 'Myopia, or nearsightedness, makes distant objects appear blurry because light focuses in front of the retina rather than directly on it.',
    },
    presbyopia: {
      title: 'Presbyopia',
      description: 'Presbyopia is an age-related change that gradually makes it harder to focus on nearby objects, usually becoming noticeable in adulthood.',
    },
  };

  return Object.entries(conditions).map(([slug, condition]) => ({
    params: { slug },
    props: { condition },
  }));
}

const { condition } = Astro.props;
---

<Layout title={`${condition.title} | Hernandez Mercado Eye Clinic`}>
  <SiteHeader />
  <main class="condition-page">
    <section class="condition-page-hero section-surface">
      <div class="container">
        <a class="back-link" href="/#about">About the clinic</a>
        <span class="eyebrow">Eye Condition</span>
        <h1>{condition.title}</h1>
        <p>{condition.description}</p>
      </div>
    </section>
    {condition.article && (
      <article class="condition-article container">
        <section>
          <h2>What Is Astigmatism?</h2>
          <p>
            Astigmatism is a refractive error caused by an uneven curve in the cornea or lens. A
            normally rounded eye focuses incoming light toward one point on the retina; with
            astigmatism, the uneven shape can spread focus across different directions and make
            vision look blurred or distorted.
          </p>
          <p>
            It may be present from childhood or develop later. If you notice a change in your
            vision, schedule an eye examination so the cause can be assessed.
          </p>
        </section>

        <section>
          <h2>Symptoms and Causes</h2>
          <h3>Common symptoms</h3>
          <p>
            Astigmatism can affect vision at near and far distances. Symptoms may include blurred
            or distorted details, overlapping images, glare or halos around lights, squinting,
            headaches, eye fatigue, and eye strain.
          </p>
          <p>
            Children may not describe blurred vision clearly. Frequent squinting, eye rubbing, or
            headaches can be reasons to arrange a pediatric eye assessment.
          </p>
          <h3>Possible causes</h3>
          <p>
            The most common cause is corneal astigmatism, where the cornea has an oval or irregular
            curve. Lenticular astigmatism involves an irregularly shaped lens. Eyelid pressure,
            an eye injury, keratoconus, lenticonus, a stye, or changes after eye surgery may also
            contribute in some cases.
          </p>
        </section>

        <section>
          <h2>Diagnosis and Tests</h2>
          <p>
            An eye doctor evaluates astigmatism during a comprehensive examination. The assessment
            may include checking visual clarity, examining the front and inside of the eye, and
            using refraction to measure how the eyes focus and bend light. The results help guide
            the most suitable correction for your needs.
          </p>
        </section>

        <section>
          <h2>Management and Treatment</h2>
          <h3>Corrective lenses</h3>
          <p>
            Glasses or contact lenses are common ways to improve clarity. Mild astigmatism may not
            require immediate correction if it does not affect daily activities, but regular
            examinations can monitor changes over time.
          </p>
          <h3>Other options</h3>
          <p>
            Depending on the type and amount of astigmatism, an eye-care provider may discuss
            specialty contact lenses or orthokeratology. Laser vision procedures such as LASIK or
            PRK can reshape the cornea for selected patients, while people with cataracts may be
            able to address both conditions during cataract treatment. Suitability must be decided
            by a qualified eye-care professional.
          </p>
        </section>

        <section>
          <h2>When Should I See an Eye-Care Provider?</h2>
          <p>
            Arrange an examination if your vision becomes blurry, distorted, or noticeably worse,
            especially at night, in rain, or around bright lights. Regular eye examinations are a
            practical way to track changes even when symptoms are mild.
          </p>
        </section>

        <section>
          <h2>Outlook</h2>
          <p>
            Astigmatism is usually manageable with appropriate correction and follow-up. Glasses,
            contact lenses, or a suitable vision-correction procedure can improve clarity, but the
            right option depends on your examination results, age, eye health, and lifestyle.
          </p>
        </section>

        <aside class="condition-note">
          <strong>Important:</strong> This page is for general education and does not replace a
          professional diagnosis. Ask your eye-care provider how often you should have your eyes
          checked and which treatment is appropriate for you.
        </aside>

        <section class="condition-references">
          <h2>References</h2>
          <ol>
            <li>
              American Optometric Association. <em>Astigmatism</em>. Accessed March 23, 2026.
              <a href="https://www.aoa.org/healthy-eyes/eye-and-vision-conditions/astigmatism?sso=y" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              Gurnani B, Kaur K. <em>Astigmatism</em>. StatPearls [Internet]. Updated June 26,
              2023. StatPearls Publishing; 2026 Jan-. Accessed March 23, 2026.
              <a href="https://www.ncbi.nlm.nih.gov/books/NBK582142/" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              National Eye Institute (U.S.). <em>Astigmatism</em>. Last updated December 4, 2024.
              Accessed March 23, 2026.
              <a href="https://www.nei.nih.gov/learn-about-eye-health/eye-conditions-and-diseases/astigmatism" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
          </ol>
        </section>
      </article>
    )}
    {condition.title === 'Glaucoma' && (
      <article class="condition-article container">
        <section>
          <h2>What Is Glaucoma?</h2>
          <p>
            Glaucoma refers to a group of eye diseases that can damage the optic nerve and cause
            permanent vision loss or blindness. It can happen for several reasons, and many forms
            can be managed when detected early. Regular eye examinations help identify risk factors
            and changes before significant vision loss occurs.
          </p>
        </section>

        <section>
          <h2>What Are the Symptoms of Glaucoma?</h2>
          <p>
            In its early stages, glaucoma may not cause noticeable symptoms. Vision changes may not
            appear until the condition has already caused irreversible damage. Possible symptoms
            include:
          </p>
          <ul>
            <li><a href="https://my.clevelandclinic.org/health/symptoms/17796-eye-pain" target="_blank" rel="noopener noreferrer">Eye pain</a> or pressure</li>
            <li><a href="https://my.clevelandclinic.org/health/diseases/9639-headaches" target="_blank" rel="noopener noreferrer">Headaches</a></li>
            <li><a href="https://my.clevelandclinic.org/health/symptoms/17690-red-eye" target="_blank" rel="noopener noreferrer">Red or bloodshot eyes</a></li>
            <li>Double vision (diplopia)</li>
            <li><a href="https://my.clevelandclinic.org/health/symptoms/24262-blurred-vision" target="_blank" rel="noopener noreferrer">Blurred vision</a></li>
            <li>Gradually developing low vision</li>
            <li>Gradually developing blind spots or tunnel vision</li>
          </ul>
          <h3>Emergency symptoms</h3>
          <p>
            Some forms, particularly angle-closure glaucoma, can cause sudden severe symptoms that
            need immediate medical attention. Seek urgent care for:
          </p>
          <ul>
            <li>Severe eye pain or pressure</li>
            <li>Nausea or vomiting with eye pain or pressure</li>
            <li>Rainbow-colored halos around lights</li>
            <li>Sudden vision loss, flashing lights, or a sudden increase in floaters</li>
            <li>Blood gathering in front of the iris or a visibly enlarged eyeball</li>
          </ul>
        </section>

        <section>
          <h2>What Causes Glaucoma?</h2>
          <p>
            Glaucoma is caused by damage to the optic nerve. Intraocular pressure is an important
            risk factor. The eye produces a nourishing fluid called aqueous humor. Normally, this
            fluid drains through mesh-like canals where the iris and cornea meet. If resistance in
            these drainage canals increases, fluid can build up, raise pressure inside the eye, and
            eventually damage the optic nerve.
          </p>
          <p>
            The reason fluid builds up varies by the type of glaucoma. Some people develop optic
            nerve damage even when their eye pressure is within the usual range.
          </p>
        </section>

        <section>
          <h2>Types of Glaucoma</h2>
          <ul>
            <li>
              <strong>Primary open-angle glaucoma:</strong> the drainage angle remains open, but
              fluid does not drain efficiently. This is the most common type.
            </li>
            <li>
              <strong>Primary angle-closure glaucoma:</strong> the iris can narrow or block the
              drainage angle, causing pressure to rise quickly or gradually.
            </li>
            <li>
              <strong>Secondary glaucoma:</strong> another condition, injury, medicine, or eye
              procedure contributes to increased pressure and optic nerve damage.
            </li>
            <li>
              <strong>Congenital glaucoma:</strong> differences that occur during fetal development
              affect how fluid drains from the eye.
            </li>
          </ul>
        </section>

        <section>
          <h2>What Are the Risk Factors?</h2>
          <p>Several factors can increase the chance of developing glaucoma, including:</p>
          <ul>
            <li>Age, especially being 40 or older</li>
            <li>Family history of glaucoma</li>
            <li>Being of African, Asian, or Inuit ancestry, depending on the type of glaucoma</li>
            <li>Nearsightedness or farsightedness</li>
            <li>High blood pressure, diabetes, or other chronic conditions</li>
            <li>Previous eye injury or surgery</li>
            <li>Use of medicines such as corticosteroids, when relevant to the individual</li>
          </ul>
        </section>

        <section>
          <h2>What Are the Complications?</h2>
          <p>
            Without treatment to manage eye pressure and protect the optic nerve, glaucoma can
            damage the retina and optic nerve progressively. This may cause permanent loss of
            peripheral vision, central vision, or eventually all vision in the affected eye.
          </p>
        </section>

        <section>
          <h2>How Is Glaucoma Diagnosed?</h2>
          <p>
            An eye-care specialist can detect glaucoma through a comprehensive eye examination,
            sometimes before symptoms or noticeable vision loss develop. Testing may include:
          </p>
          <ul>
            <li>Visual acuity testing</li>
            <li>Visual field testing</li>
            <li>Depth perception testing</li>
            <li>Tonometry to measure eye pressure</li>
            <li>Pachymetry to measure corneal thickness</li>
            <li>Slit-lamp examination</li>
            <li>Gonioscopy to examine the drainage angle</li>
          </ul>
          <p>
            If retinal or optic nerve damage is suspected, additional imaging may include optical
            coherence tomography, fluorescein angiography, or ultrasound. In selected cases, CT or
            MRI may also be considered.
          </p>
        </section>

        <section>
          <h2>How Is Glaucoma Treated?</h2>
          <p>
            The main goal of treatment is to lower intraocular pressure and prevent or slow further
            optic nerve damage. Treatment depends on the type and severity of glaucoma and may
            include:
          </p>
          <ul>
            <li>
              <strong>Medications:</strong> prescription eye drops or other medicines can lower
              pressure or reduce fluid production.
            </li>
            <li>
              <strong>Laser treatment:</strong> selected procedures can improve fluid drainage or
              reduce fluid production.
            </li>
            <li>
              <strong>Surgery:</strong> trabeculectomy, tube shunts, and minimally invasive glaucoma
              surgeries may improve drainage when other treatments are not enough.
            </li>
          </ul>
          <p>
            Follow your eye-care specialist's instructions carefully and do not stop prescribed
            glaucoma medicine without discussing it with them.
          </p>
        </section>

        <section>
          <h2>Outlook and Prevention</h2>
          <p>
            Without treatment, glaucoma can cause permanent vision loss. With early detection and
            appropriate care, treatment may slow the disease or keep it from worsening. Glaucoma
            cannot always be prevented, but regular eye examinations, managing ocular hypertension,
            controlling conditions such as high blood pressure and diabetes, and protecting the eyes
            from injury can help reduce risk and delay vision loss.
          </p>
        </section>

        <section>
          <h2>Living With Glaucoma</h2>
          <ul>
            <li>Follow your treatment plan and attend recommended follow-up visits.</li>
            <li>Tell your provider about new symptoms, vision changes, or treatment side effects.</li>
            <li>Stay physically active, while asking which activities are appropriate for you.</li>
            <li>Ask your eye-care specialist how to protect your remaining vision.</li>
          </ul>
          <p>
            Seek immediate medical care for sudden severe eye pain or pressure, nausea and vomiting
            with eye pain, halos around lights, flashing lights, sudden floaters, or any sudden loss
            of vision.
          </p>
        </section>

        <aside class="condition-note">
          <strong>Important:</strong> This page is for general education and does not replace a
          professional diagnosis. If you have symptoms or risk factors for glaucoma, schedule an
          eye examination and follow your eye-care provider's advice.
        </aside>

        <section class="condition-references">
          <h2>References</h2>
          <ol>
            <li>
              Allison K, Patel D, Alabi O. <em>Epidemiology of Glaucoma: The Past, Present, and Predictions for the Future</em>.
              <em>Cureus</em>. 2020 Nov;12(11):e11686. Accessed November 12, 2024.
              <a href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7769798/" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              American Academy of Ophthalmology EyeWiki. <em>Multiple pages reviewed</em>. Accessed
              November 12, 2024.
            </li>
            <li>
              Cioffi GA, Liebmann JM. Diseases of the Visual System. In: Goldman L, Cooney KA,
              editors. <em>Goldman-Cecil Medicine</em>. 27th ed. Elsevier; 2024:2596-2614.
              Accessed November 12, 2024.
            </li>
            <li>
              Dietze J, Blair K, Zeppieri M, et al. <em>Glaucoma</em>. StatPearls [Internet].
              Treasure Island (FL): StatPearls Publishing; 2024 Jan. Updated March 16, 2024.
              Accessed November 12, 2024.
              <a href="https://www.ncbi.nlm.nih.gov/books/NBK538217/" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              Horton JC. Disorders of the Eye. In: Loscalzo J, Fauci A, Kasper D, Hauser S,
              Longo D, Jameson JL, editors. <em>Harrison's Principles of Internal Medicine</em>.
              21st ed. McGraw-Hill Education; 2022. Accessed November 12, 2024.
            </li>
            <li>
              Machiele R, Motlagh M, Zeppieri M, et al. <em>Intraocular Pressure</em>. StatPearls
              [Internet]. Treasure Island (FL): StatPearls Publishing; 2024 Jan. Updated February
              27, 2024. Accessed November 12, 2024.
              <a href="https://www.ncbi.nlm.nih.gov/books/NBK532237/" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              Mohammed TK, Ramulu PY, Saeedi OJ. Epidemiology of Glaucoma. In: Vanoff M, Duker
              JS, editors. <em>Ophthalmology</em>. 6th ed. Elsevier; 2023:947-952. Accessed
              November 12, 2024.
            </li>
            <li>
              Salmon JF. Glaucoma. In: Riordan-Eva P, Augsburger JJ, editors. <em>Vaughan &amp;
              Asbury's General Ophthalmology</em>. 19th ed. McGraw-Hill Education; 2017. Accessed
              November 12, 2024.
            </li>
            <li>
              Scott AW, Bressler NM, Ffolkes S, Wittenborn JS, Jorkasky J. Public Attitudes About
              Eye and Vision Health. <em>JAMA Ophthalmology</em>. 2016 Oct;134(10):1111-1118.
              Accessed November 12, 2024.
              <a href="https://pubmed.ncbi.nlm.nih.gov/27490785/" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              Yang SN, Shi Y, Berggren PO. The anterior chamber of the eye technology and its
              anatomical, optical, and immunological bases. <em>Physiological Reviews</em>. 2024
              Jul;104(3):881-929. Accessed November 12, 2024.
              <a href="https://pubmed.ncbi.nlm.nih.gov/38206586/" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
          </ol>
        </section>
      </article>
    )}
    {condition.articleType === 'dry-eye' && (
      <article class="condition-article container">
        <section>
          <h2>What Is Dry Eye?</h2>
          <p>
            Dry eye disease affects the tear film that coats and protects the eye. When the eyes
            do not make enough tears, or when tears evaporate too quickly, the surface can become
            uncomfortable and vision may fluctuate.
          </p>
          <p>
            People may notice burning, itching, watering, grittiness, light sensitivity, or a
            feeling that something is in the eye. Finding the cause can take time, so ongoing or
            worsening symptoms should be assessed by an optometrist or ophthalmologist.
          </p>
        </section>

        <section>
          <h2>Types of Dry Eye Disease</h2>
          <p>Dry eye may be grouped according to how the tear film is affected:</p>
          <ul>
            <li><strong>Aqueous-deficient dry eye:</strong> the lacrimal glands do not produce enough of the watery tear layer.</li>
            <li><strong>Evaporative dry eye:</strong> tears disappear too quickly, often when the oil-producing meibomian glands are not working well.</li>
            <li><strong>Mixed dry eye:</strong> reduced tear production and tear-film instability occur together.</li>
          </ul>
        </section>

        <section>
          <h2>Symptoms and Causes</h2>
          <h3>Common symptoms</h3>
          <p>
            Symptoms can include a scratchy or sandy sensation, burning or stinging, blurry or
            fluctuating vision, sensitivity to light, mucus or discharge, and watery eyes. Excess
            watering can happen when irritation triggers the lacrimal glands to produce reflex tears
            that do not correct the underlying tear-film problem.
          </p>
          <h3>Causes and risk factors</h3>
          <p>
            Dry eye can occur by itself or alongside conditions such as blepharitis, thyroid eye
            disease, or autoimmune disorders including Sjogren syndrome. Risk can also be affected
            by age, dry or windy environments, extended screen use, contact lenses, smoking,
            allergies, and some medicines used for depression, allergies, blood pressure, glaucoma,
            menopause, or pain.
          </p>
          <p>
            Previous eye procedures, including LASIK or cataract surgery, may also increase the
            chance of dry-eye symptoms. Your clinician can help determine which factors are relevant
            to you.
          </p>
        </section>

        <section>
          <h2>Possible Complications</h2>
          <p>
            Untreated or severe dryness can cause persistent irritation and may affect the corneal
            surface. In more serious cases, complications can include corneal damage, ulcers,
            scarring, infection, or reduced visual quality.
          </p>
        </section>

        <section>
          <h2>Diagnosis and Tests</h2>
          <p>
            Diagnosis begins with questions about symptoms, medical history, medicines, environment,
            screen habits, and contact-lens use. A comprehensive eye examination then checks the
            eyelids, eye surface, and tear film.
          </p>
          <p>Depending on the findings, testing may include:</p>
          <ul>
            <li><strong>Slit-lamp examination:</strong> a microscope and light are used to inspect the eyes and eyelids.</li>
            <li><strong>Schirmer test:</strong> a small strip measures tear production.</li>
            <li><strong>Tear breakup time:</strong> dye helps show how long the tear film remains stable before evaporating.</li>
            <li><strong>Additional testing:</strong> laboratory or antibody tests may be considered when an underlying condition is suspected.</li>
          </ul>
        </section>

        <section>
          <h2>Management and Treatment</h2>
          <p>
            Treatment depends on the severity of symptoms, tear-film findings, and any underlying
            condition. Options may include lubricating artificial tears, thicker nighttime ointments,
            prescription medicines, tear stimulation, punctal occlusion, or specialty scleral lenses.
            Selected patients may need treatment for eyelid problems or other procedures recommended
            by an eye-care professional.
          </p>
          <h3>Self-care measures</h3>
          <ul>
            <li>Limit exposure to smoke, wind, direct air vents, and other personal triggers.</li>
            <li>Use a humidifier when indoor air is dry and consider protective glasses outdoors.</li>
            <li>Apply a warm eye compress for about 10 minutes when advised by your provider.</li>
            <li>Take regular screen breaks and blink fully and frequently.</li>
            <li>Discuss supplements such as omega-3 fatty acids with your clinician before starting them.</li>
          </ul>
        </section>

        <section>
          <h2>When Should I See My Healthcare Provider?</h2>
          <p>
            Keep scheduled follow-ups so your care team can monitor symptoms and treatment response.
            Contact your eye-care provider if you develop new symptoms, worsening discomfort, or
            side effects from treatment. Prompt assessment is especially important when vision
            changes or significant pain occurs.
          </p>
        </section>

        <section>
          <h2>Outlook</h2>
          <p>
            Dry eye is often a long-term condition rather than something that disappears permanently,
            but treatment can make symptoms much easier to manage. Finding the right plan may require
            adjustments over time. Regular eye examinations help protect comfort, the ocular surface,
            and visual function.
          </p>
        </section>

        <aside class="condition-note">
          <strong>Important:</strong> This page is for general education and does not replace a
          professional diagnosis. Ask your eye-care provider which treatment is appropriate for you.
        </aside>

        <section class="condition-references">
          <h2>References</h2>
          <ol>
            <li>
              American Academy of Ophthalmology. <em>What Is Dry Eye? Symptoms, Causes and Treatment</em>.
              Published October 15, 2024. Accessed June 20, 2025.
              <a href="https://www.aao.org/eye-health/diseases/what-is-dry-eye" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              American Optometric Association. <em>Dry Eye</em>. Accessed June 20, 2025.
              <a href="https://www.aoa.org/healthy-eyes/eye-and-vision-conditions/dry-eye" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              Golden MI, Meyer JJ, Zeppieri M, Patel BC. <em>Dry Eye Syndrome</em>. StatPearls
              [Internet]. Updated February 29, 2024. StatPearls Publishing; 2025 Jan. Accessed
              June 20, 2025.
              <a href="https://pubmed.ncbi.nlm.nih.gov/29262012/" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              Merck Manual (Consumer Version). <em>Keratoconjunctivitis Sicca</em>. Last reviewed
              July 2024. Accessed June 20, 2025.
              <a href="https://www.merckmanuals.com/home/eye-disorders/corneal-disorders/keratoconjunctivitis-sicca" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
            <li>
              National Eye Institute (U.S.). <em>Dry Eye</em>. Last updated February 18, 2025.
              Accessed June 20, 2025.
              <a href="https://www.nei.nih.gov/learn-about-eye-health/eye-conditions-and-diseases/dry-eye" target="_blank" rel="noopener noreferrer">Read source</a>
            </li>
          </ol>
        </section>
      </article>
    )}
    <section class="condition-page-content container">
      <article class="condition-info-card">
        <span class="eyebrow">What to do next</span>
        <h2>Have questions about your vision?</h2>
        <p>
          A professional eye examination can help assess your symptoms and determine the right next
          steps for your visual needs.
        </p>
        <a class="btn btn-primary" href="/#contact">Book an Eye Exam</a>
      </article>
    </section>
  </main>
  <SiteFooter />
</Layout>
