</section>


  </main>

  <SiteFooter current="home" />
</Layout>

<script>
  // Check for active login session to update navigation options dynamically
  const token = localStorage.getItem('hmVisionToken');
  const user = JSON.parse(localStorage.getItem('hmVisionUser') || 'null');
  if (token && user && user.role) {
    document.querySelectorAll('a[href="/login"]').forEach((link) => {
      if (link.textContent.trim() === 'Open Patient Portal') {
        link.setAttribute('href', `/dashboard/${user.role}/dashboard`);
        link.textContent = 'Go to Patient Portal';
      }
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));

  const colorValues = {
    'Matte Black': '#202526',
    Tortoise: '#8a5b3d',
    'Crystal Clear': '#a9d0cc',
    Black: '#202526',
    'Smoke Gray': '#6d858b',
    'Clear Blue Filter': '#8cc9d6',
    Clear: '#dbe9e6',
    Hazel: '#9b744f',
    Brown: '#704a34',
  };

  document.querySelectorAll('.homepage-eyewear-card').forEach((card) => {
    const image = card.querySelector('img');
    card.querySelectorAll('.color-option').forEach((option) => {
      const color = option.dataset.color;
      const swatch = option.querySelector('.color-swatch');
      if (swatch) swatch.style.background = colorValues[color] || '#a9d0cc';
      option.addEventListener('click', () => {
        card.querySelectorAll('.color-option').forEach((item) => {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        option.classList.add('is-selected');
        option.setAttribute('aria-pressed', 'true');
      });
    });

  });
</script>
