---
import Layout from '../layouts/Layout.astro';

const navItems = ['Home', 'About', 'Services', 'Eyewear', 'Why Choose Us', 'Contact'];

const highlights = [
  {
    title: 'Comprehensive Eye Exams',
    description: 'Professional eye examinations designed to provide accurate results.',
    icon: 'eye',
  },
  {
    title: 'State-of-the-Art Equipment',
    description: 'Modern diagnostic equipment for precise eye assessment.',
    icon: 'sparkles',
  },
  {
    title: 'Stylish & Affordable Frames',
    description: 'A wide selection of fashionable eyewear at accessible prices.',
    icon: 'glasses',
  },
  {
    title: 'Patient-Centered Care',
    description: "Friendly and personalized service focused on every patient's needs.",
    icon: 'heart',
  },
];

const services = [
  {
    title: 'Comprehensive Eye Examination',
    description:
      'Thorough eye assessments using modern equipment to evaluate visual health and provide accurate results.',
    icon: 'clipboard',
  },
  {
    title: 'Vision Assessment',
    description: 'Professional evaluation of visual clarity and prescription requirements.',
    icon: 'focus',
  },
  {
    title: 'Prescription Eyewear',
    description: 'Quality prescription glasses designed to match your vision needs and lifestyle.',
    icon: 'lens',
  },
  {
    title: 'Eyewear Consultation',
    description:
      'Get assistance choosing frames that complement your face, style, and everyday needs.',
    icon: 'frame',
  },
  {
    title: 'Eye Health Screening',
    description:
      'Professional screening designed to help identify potential eye health concerns.',
    icon: 'shield',
  },
  {
    title: 'Optical Consultation',
    description: 'Personalized guidance for selecting appropriate eyewear and vision solutions.',
    icon: 'chat',
  },
];

const examinationSteps = [
  {
    number: '01',
    title: 'Consultation',
    description: 'Understand your vision concerns and needs.',
  },
  {
    number: '02',
    title: 'Eye Examination',
    description: 'Perform a comprehensive assessment using modern equipment.',
  },
  {
    number: '03',
    title: 'Results & Recommendation',
    description: 'Discuss the examination results and appropriate next steps.',
  },
  {
    number: '04',
    title: 'Eyewear Selection',
    description: 'Choose from stylish and affordable frames suited to your needs.',
  },
];

const eyewearStyles = [
  {
    name: 'Reading Glasses',
    slug: 'reading-glasses',
    size: '52 mm',
    colors: 'Matte Black, Tortoise, Crystal Clear',
    price: 'PHP 899',
    description: 'Comfortable near-vision support in styles for Men, Women, Kids, and Unisex wear.',
    image:
      'https://images.unsplash.com/photo-1577803645773-f96470509666?auto=format&fit=crop&w=900&q=80',
  },
  {
    name: 'Sunglasses',
    slug: 'sunglasses',
    size: '58 mm',
    colors: 'Tortoise, Black, Smoke Gray',
    price: 'PHP 1,299',
    description: 'Everyday sun protection in styles for Men, Women, Kids, and Unisex wear.',
    image:
      'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=900&q=80',
  },
  {
    name: 'Anti-Rad',
    slug: 'anti-rad',
    size: '52 mm',
    colors: 'Clear Blue Filter, Clear, Smoke Gray',
    price: 'PHP 1,499',
    description: 'Protective lens options designed for screen-heavy routines and modern lifestyles.',
    image:
      'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=900&q=80',
  },
  {
    name: 'Contact Lens',
    slug: 'contact-lens',
    size: '14.2 mm',
    colors: 'Hazel, Brown, Clear',
    price: 'PHP 899',
    description: 'Colored and clear contact lenses, plus solutions for daily lens care.',
    image:
      'https://images.unsplash.com/photo-1556306535-38febf6782e7?auto=format&fit=crop&w=900&q=80',
  },
  {
    name: 'Accessories',
    slug: 'accessories',
    size: 'Universal',
    colors: 'Black, Clear, Brown',
    price: 'PHP 199',
    description: 'Cases, cloths, chains, and practical essentials for eyewear care.',
    image:
      'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=900&q=80',
  },
];

const reasons = [
  {
    title: 'Modern Technology',
    description: 'State-of-the-art equipment designed to support accurate examinations.',
    icon: 'tech',
  },
  {
    title: 'Professional Care',
    description: 'A patient-focused approach to eye care.',
    icon: 'care',
  },
  {
    title: 'Stylish Selection',
    description: 'Frames that combine comfort, functionality, and modern style.',
    icon: 'style',
  },
  {
    title: 'Affordable Options',
    description: 'Quality eyewear designed to remain accessible to more patients.',
    icon: 'tag',
  },
];

const socialLink = 'https://www.facebook.com/profile.php?id=61574615712787';
---

<Layout>
  <header class="site-header">
    <nav class="nav container" aria-label="Main navigation">
      <a href="#home" class="brand" aria-label="Hernandez Mercado Eye Clinic home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" role="img" aria-hidden="true">
            <path d="M8 32c0-11.8 9.5-21.3 21.3-21.3h5.4C46.5 10.7 56 20.2 56 32s-9.5 21.3-21.3 21.3h-5.4C17.5 53.3 8 43.8 8 32zm14.5 0c0 5.1 3.9 9.2 8.8 9.2s8.8-4.1 8.8-9.2-3.9-9.2-8.8-9.2-8.8 4.1-8.8 9.2zm31.2 0c0-7.4-5.8-13.4-13.2-13.4-7.3 0-13.2 6-13.2 13.4s5.9 13.4 13.2 13.4c7.4 0 13.2-6 13.2-13.4z"/>
          </svg>
        </span>
        <span>Hernandez Mercado Eye Clinic</span>
      </a>

      <button class="nav-toggle" aria-label="Open menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="nav-menu">
        {navItems.map((item) => (
          <a href={item === 'Home' ? '#home' : `#${item.toLowerCase().replace(/\s+/g, '-')}`}>
            {item}
          </a>
        ))}
        <a href="/login" class="btn btn-primary">Login</a>
        <a href="/register" class="btn btn-secondary">Sign Up</a>
      </div>
    </nav>
  </header>

  <main id="home">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <span class="eyebrow">Trusted Eye Care in Santa Rosa</span>
          <h1>Healthy Eyes, Meaningful Lives</h1>
          <p>
            Comprehensive eye care, accurate examinations, and stylish eyewear — all in one
            trusted clinic in Santa Rosa, Nueva Ecija.
          </p>
          <div class="hero-actions">
            <a href="#contact" class="btn btn-primary">Book an Eye Exam</a>
            <a href="#services" class="btn btn-secondary">Explore Our Services</a>
          </div>
          <ul class="hero-meta" aria-label="Clinic highlights">
            <li>New optical clinic</li>
            <li>Modern equipment</li>
            <li>Patient-first care</li>
          </ul>
        </div>

        <div class="hero-visual reveal" aria-label="Optical care patient experience">
          <div class="visual-card">
            <img
              src="https://images.unsplash.com/photo-1584515933487-779824d29309?auto=format&fit=crop&w=1200&q=80"
              alt="Optometrist examining a patient during an eye consultation"
            />
          </div>
          <div class="floating-badge badge-top">
            <strong>Comprehensive care</strong>
            <span>Professional evaluation</span>
          </div>
          <div class="floating-badge badge-bottom">
            <strong>Modern optics</strong>
            <span>Comfort & style</span>
          </div>
        </div>
      </div>
    </section>

    <section class="highlights container reveal" aria-label="Clinic highlights">
      <div class="highlight-grid">
        {highlights.map((item) => (
          <article class="highlight-card">
            <div class="icon-wrap" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {item.icon === 'eye' && (
                  <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
                )}
                {item.icon === 'sparkles' && (
                  <path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8L12 2Zm7 12l.9 2.1L20 17l-2.1.9L17 20l-.9-2.1L14 17l2.1-.9L17 14ZM5 14l.9 2.1L8 17l-2.1.9L5 20l-.9-2.1L2 17l2.1-.9L5 14Z" />
                )}
                {item.icon === 'glasses' && (
                  <path d="M2 14V9a2 2 0 0 1 2-2h2.5A2.5 2.5 0 0 1 9 9.5V11h6V9.5A2.5 2.5 0 0 1 17.5 7H20a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1.3a2.7 2.7 0 0 1-2.7-2.7V13h-6v1.3A2.7 2.7 0 0 1 7.3 17H6a2 2 0 0 1-2-2h0Z" />
                )}
                {item.icon === 'heart' && (
                  <path d="M12 20.5c-.4 0-.8-.1-1.1-.4C5.3 15.7 2 12.9 2 9.3A4.3 4.3 0 0 1 6.3 5a4.7 4.7 0 0 1 3.9 2.1A4.7 4.7 0 0 1 14.1 5 4.3 4.3 0 0 1 18.4 9.3c0 3.6-3.3 6.4-8.9 10.8a1.7 1.7 0 0 1-1.1.4Z" />
                )}
              </svg>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="about container reveal">
      <div class="about-image">
        <img
          src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=1200&q=80"
          alt="Eye care professional consulting a patient"
        />
      </div>
      <div class="about-copy">
        <span class="eyebrow">About the clinic</span>
        <h2>Your Vision Deserves Expert Care</h2>
        <p>
          Hernandez Mercado Eye Clinic is the newest optical clinic serving the Santa Rosa, Nueva
          Ecija community, offering comprehensive eye care with accurate examination and modern,
          professional support.
        </p>
        <p>
          We combine professional eye care, modern equipment, and a welcoming patient experience to
          help you find eyewear that fits your vision, lifestyle, and personal style.
        </p>
        <p class="quote">
          “At Hernandez Mercado Eye Clinic, we believe better vision can lead to a better quality of
          life. Our goal is to provide reliable eye care while helping every patient find eyewear
          that fits their vision, lifestyle, and personal style.”
        </p>
      </div>
    </section>

    <section id="services" class="services section-surface reveal">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">Our Services</span>
          <h2>Comprehensive Eye Care for Every Need</h2>
        </div>

        <div class="services-grid">
          {services.map((service) => (
            <article class="service-card">
              <div class="service-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  {service.icon === 'clipboard' && (
                    <path d="M9 3h6a2 2 0 0 1 2 2v1h2a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2V5a2 2 0 0 1 2-2Zm0 5h6M9 11h6M9 15h4" />
                  )}
                  {service.icon === 'focus' && (
                    <path d="M12 2v3M12 19v3M4.93 4.93l2.12 2.12M16.95 16.95l2.12 2.12M2 12h3M19 12h3M4.93 19.07l2.12-2.12M16.95 7.05l2.12-2.12M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" />
                  )}
                  {service.icon === 'lens' && (
                    <path d="M2 12a10 10 0 0 1 20 0M7 12h10M8 9.5A2.5 2.5 0 0 1 10.5 7H13a2.5 2.5 0 0 1 0 5h-2.5A2.5 2.5 0 0 1 8 9.5Zm8 5a2.5 2.5 0 0 1-2.5 2.5H11a2.5 2.5 0 0 1 0-5h2.5A2.5 2.5 0 0 1 16 14.5Z" />
                  )}
                  {service.icon === 'frame' && (
                    <path d="M4 12V8a2 2 0 0 1 2-2h2.5A2.5 2.5 0 0 1 11 8.5V10h2V8.5A2.5 2.5 0 0 1 15.5 6H18a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1.3A2.7 2.7 0 0 1 14 13.3V13h-4v.3A2.7 2.7 0 0 1 7.3 16H6a2 2 0 0 1-2-2Z" />
                  )}
                  {service.icon === 'shield' && (
                    <path d="M12 3.5 18.5 6v5c0 4.5-2.7 8.2-6.5 10.5C8.2 19.2 5.5 15.5 5.5 11V6L12 3.5Zm-1 5.5h2v4h-2V9Zm0 5h2v2h-2v-2Z" />
                  )}
                  {service.icon === 'chat' && (
                    <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H11l-5 4v-4.5A2.5 2.5 0 0 1 4 13.5v-7Zm3 3h10M7 10.5h10M7 14h7" />
                  )}
                </svg>
              </div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="exam-process container reveal">
      <div class="section-header center">
        <span class="eyebrow">Eye Examination Experience</span>
        <h2>See Clearly. Live Fully.</h2>
      </div>
      <p class="process-intro">
        Experience a comprehensive eye examination supported by modern equipment and a professional
        approach to eye care.
      </p>
      <div class="timeline">
        {examinationSteps.map((step) => (
          <article class="timeline-item">
            <span class="step-number">{step.number}</span>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="eyewear" class="eyewear section-surface reveal">
      <div class="container">
        <div class="section-header split">
          <div>
            <span class="eyebrow">Eyewear Collection</span>
            <h2>Style Your Vision</h2>
          </div>
          <a href="/eyewear" class="btn btn-secondary">Explore Eyewear</a>
        </div>
        <p class="section-copy">
          Discover stylish, comfortable, and affordable frames selected to complement different
          personalities and lifestyles.
        </p>
        <div class="eyewear-grid">
          {eyewearStyles.map((style) => (
            <article class="eyewear-card homepage-eyewear-card">
              <img src={style.image} alt={style.name} />
              <div class="eyewear-card-body">
                <h3>{style.name}</h3>
                <p>{style.description}</p>
                <div class="eyewear-product-meta">
                  <div class="eyewear-color-picker">
                    <span class="eyewear-color-label">Color</span>
                    <div class="color-options" role="group" aria-label={`Choose a color for ${style.name}`}>
                      {style.colors.split(', ').map((color, index) => (
                        <button type="button" class={`color-option ${index === 0 ? 'is-selected' : ''}`} data-color={color} aria-label={`${color} color`} aria-pressed={index === 0 ? 'true' : 'false'} title={color}>
                          <i class="color-swatch" aria-hidden="true"></i>
                        </button>
                      ))}
                    </div>
                  </div>
                  <strong>{style.price}</strong>
                </div>
                <a class="text-link" href={`/eyewear#${style.slug}`}>View Collection</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="why-choose-us" class="reasons container reveal">
      <div class="section-header center">
        <span class="eyebrow">Why choose us</span>
        <h2>Why Choose Hernandez Mercado Eye Clinic?</h2>
      </div>
      <div class="reasons-grid">
        {reasons.map((reason) => (
          <article class="reason-card">
            <div class="reason-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {reason.icon === 'tech' && (
                  <path d="M9 3h6v2h2a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-2v2h2v2H7v-2h2v-2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2V3Zm1 5h4v4H10V8Z" />
                )}
                {reason.icon === 'care' && (
                  <path d="M12 21.3c-.4 0-.8-.1-1.1-.4C6 17.3 3 14.8 3 10.8A4.8 4.8 0 0 1 7.8 6a5.2 5.2 0 0 1 4.2 2.2A5.2 5.2 0 0 1 16.2 6 4.8 4.8 0 0 1 21 10.8c0 4-3 6.5-7.9 10.1-.3.3-.7.4-1.1.4Z" />
                )}
                {reason.icon === 'style' && (
                  <path d="M6 7.5a6 6 0 0 1 12 0v7.3a3.2 3.2 0 0 1-3.2 3.2H9.2A3.2 3.2 0 0 1 6 14.8V7.5Zm2.5 0h7M9 12h6" />
                )}
                {reason.icon === 'tag' && (
                  <path d="M3 11.5V4h7.5L20 17.5 17.5 20 3 11.5Zm6.5-3A1.5 1.5 0 1 0 8 10a1.5 1.5 0 0 0 1.5-1.5Z" />
                )}
              </svg>
            </div>
            <h3>{reason.title}</h3>
            <p>{reason.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="experience section-surface reveal">
      <div class="container experience-grid">
        <div class="experience-copy">
          <span class="eyebrow">Patient experience</span>
          <h2>Your Comfort. Your Vision. Our Care.</h2>
          <p>
            We want every visit to feel comfortable, informative, and personalized — from your first
            consultation to choosing your perfect pair of frames.
          </p>
        </div>
        <div class="experience-image">
          <img
            src="https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=1200&q=80"
            alt="Friendly patient smiling during a clinic visit"
          />
        </div>
      </div>
    </section>

    <section class="cta-band">
      <div class="container cta-inner reveal">
        <div>
          <span class="eyebrow light">Your next step</span>
          <h2>Ready to See the World More Clearly?</h2>
          <p>Schedule your eye examination today and take the next step toward healthier, clearer vision.</p>
        </div>
        <div class="cta-actions">
          <a href="#contact" class="btn btn-primary inverse">Book an Eye Exam</a>
          <a href="#contact" class="btn btn-secondary light">Contact Us</a>
        </div>
      </div>
    </section>

    <section id="contact" class="contact container reveal">
      <div class="contact-copy">
        <span class="eyebrow">Contact</span>
        <h2>Visit Hernandez Mercado Eye Clinic</h2>
        <ul class="contact-list">
          <li>
            <strong>Location</strong>
            <span>Santa Rosa, Nueva Ecija, Philippines</span>
          </li>
          <li>
            <strong>Clinic Hours</strong>
            <span>Clinic hours — Contact us for the latest schedule</span>
          </li>
          <li>
            <strong>Contact</strong>
            <span>Use the Facebook page for updates and inquiries.</span>
          </li>
          <li>
            <strong>Social Media</strong>
            <a href={socialLink} target="_blank" rel="noreferrer">Facebook</a>
          </li>
        </ul>
      </div>

      <div class="contact-card contact-card-simple">
        <span class="eyebrow">Plan your visit</span>
        <h3>Ready for clearer vision?</h3>
        <p>Sign in to your patient portal to book an appointment and manage your eye care securely.</p>
        <a href="/login" class="btn btn-primary">Open Patient Portal</a>
      </div>
    </section>

    <section class="map-area reveal">
      <div class="container map-card">
        <div class="map-header">
          <span class="eyebrow">Location</span>
          <h3>Santa Rosa, Nueva Ecija, Philippines</h3>
        </div>
        <div class="map-placeholder" aria-label="Map placeholder for Santa Rosa, Nueva Ecija">
          <span>Location placeholder</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div>
        <h3>Hernandez Mercado Eye Clinic</h3>
        <p>Healthy Eyes, Meaningful Lives</p>
      </div>
      <div>
        <h4>Links</h4>
        <ul>
          <li><a href="#home">Home</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#eyewear">Eyewear</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Social</h4>
        <a href={socialLink} target="_blank" rel="noreferrer">Facebook</a>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>© 2026 Hernandez Mercado Eye Clinic. All rights reserved.</p>
      <p class="footer-legal-links"><a href="/privacy-policy">Privacy Policy</a><a href="/terms-and-conditions">Terms &amp; Conditions</a></p>
      <p>
        Information presented on this website is for general informational purposes and does not
        replace professional medical advice.
      </p>
    </div>
  </footer>
</Layout>

<script>
  const navToggle = document.querySelector('.nav-toggle');
  const navMenu = document.querySelector('.nav-menu');

  if (navToggle && navMenu) {
    navToggle.addEventListener('click', () => {
      const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
      navToggle.setAttribute('aria-expanded', String(!isExpanded));
      navMenu.classList.toggle('is-open');
    });

    navMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navMenu.classList.remove('is-open');
        navToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));

  const colorValues = {
    'Matte Black': '#202526',
    Tortoise: '#8a5b3d',
    'Crystal Clear': '#a9d0cc',
    Black: '#202526',
    'Smoke Gray': '#6d858b',
    'Clear Blue Filter': '#8cc9d6',
    Clear: '#dbe9e6',
    Hazel: '#9b744f',
    Brown: '#704a34',
  };

  document.querySelectorAll('.homepage-eyewear-card').forEach((card) => {
    const image = card.querySelector('img');
    card.querySelectorAll('.color-option').forEach((option) => {
      const color = option.dataset.color;
      const swatch = option.querySelector('.color-swatch');
      if (swatch) swatch.style.background = colorValues[color] || '#a9d0cc';
      option.addEventListener('click', () => {
        card.querySelectorAll('.color-option').forEach((item) => {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        option.classList.add('is-selected');
        option.setAttribute('aria-pressed', 'true');
      });
    });

  });
</script>
