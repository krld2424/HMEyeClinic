---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login | Hernandez Mercado Eye Clinic">
  <main class="auth-page auth-page-centered">
    <section class="auth-card auth-card-centered">
      <a class="auth-back-link" href="/">Hernandez Mercado Eye Clinic</a>
      <span class="eyebrow">Secure Access</span>
      <h1>Welcome back</h1>
      <p class="auth-intro">Sign in to continue to your clinic workspace.</p>

      <form id="login-form" class="auth-form active">
        <div class="field-group">
          <label for="login-email">Email</label>
          <input id="login-email" name="email" type="email" placeholder="name@example.com" required />
        </div>
        <div class="field-group">
          <label for="login-password">Password</label>
          <div class="password-field">
            <input id="login-password" name="password" type="password" placeholder="Enter your password" required />
            <button class="password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password">Show</button>
          </div>
        </div>
        <a class="auth-forgot-link" href="#forgot-password" id="forgot-password-link">Forgot password?</a>
        <button type="submit" class="btn btn-primary auth-submit">Sign In</button>
        <p id="login-status" class="form-status" aria-live="polite"></p>
      </form>
      <form id="reset-form" class="auth-form" hidden>
        <span class="eyebrow">Password reset</span>
        <div class="field-group"><label for="reset-email">Account email</label><input id="reset-email" name="email" type="email" required /></div>
        <button type="button" class="btn btn-secondary" id="send-reset-code">Send reset code</button>
        <div class="field-group"><label for="reset-otp">Verification code</label><input id="reset-otp" name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" /></div>
        <button type="button" class="btn btn-secondary" id="verify-reset-code">Verify code</button>
        <div class="field-group"><label for="reset-password">New password</label><input id="reset-password" name="password" type="password" minlength="8" /></div>
        <button type="submit" class="btn btn-primary auth-submit">Reset password</button>
        <button type="button" class="text-link" id="cancel-reset">Return to sign in</button>
        <p id="reset-status" class="form-status" aria-live="polite"></p>
      </form>
      <p class="auth-switch">New patient? <a href="/register">Create an account</a></p>
    </section>
  </main>

  <script type="module">
    const form = document.getElementById('login-form');
    const status = document.getElementById('login-status');
    const resetForm = document.getElementById('reset-form');
    const resetStatus = document.getElementById('reset-status');
    let resetToken = '';

    document.getElementById('forgot-password-link').addEventListener('click', (event) => {
      event.preventDefault();
      form.hidden = true;
      resetForm.hidden = false;
      resetForm.classList.add('active');
      resetForm.elements.email.value = form.elements.email.value;
    });

    const api = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';

    document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const input = document.getElementById(toggle.dataset.passwordToggle);
        const visible = input.type === 'password';
        input.type = visible ? 'text' : 'password';
        toggle.textContent = visible ? 'Hide' : 'Show';
        toggle.setAttribute('aria-label', `${visible ? 'Hide' : 'Show'} password`);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = 'Signing in...';
      status.classList.remove('error');

      try {
        const response = await fetch(`${api}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to sign in.');
        localStorage.setItem('hmVisionToken', result.token);
        localStorage.setItem('hmVisionUser', JSON.stringify(result.user));
        window.location.href = `/dashboard/${result.user.role}`;
      } catch (error) {
        status.textContent = error.message;
        status.classList.add('error');
      }
    });

    document.getElementById('send-reset-code').addEventListener('click', async () => {
      const email = resetForm.elements.email.value;
      resetStatus.textContent = 'Sending reset code...';
      resetStatus.classList.remove('error');
      try {
        const response = await fetch(`${api}/api/auth/forgot-password`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to request a reset code.');
        resetStatus.textContent = result.message;
      } catch (error) { resetStatus.textContent = error.message; resetStatus.classList.add('error'); }
    });

    document.getElementById('verify-reset-code').addEventListener('click', async () => {
      resetStatus.textContent = 'Verifying code...';
      resetStatus.classList.remove('error');
      try {
        const response = await fetch(`${api}/api/auth/verify-otp`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: resetForm.elements.email.value, otp: resetForm.elements.otp.value }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to verify code.');
        resetToken = result.resetToken;
        resetStatus.textContent = 'Code verified. Enter your new password.';
      } catch (error) { resetStatus.textContent = error.message; resetStatus.classList.add('error'); }
    });

    resetForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!resetToken) { resetStatus.textContent = 'Verify the reset code first.'; resetStatus.classList.add('error'); return; }
      try {
        const response = await fetch(`${api}/api/auth/reset-password`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ resetToken, password: resetForm.elements.password.value }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to reset password.');
        resetStatus.textContent = result.message;
        resetForm.reset();
        resetToken = '';
      } catch (error) { resetStatus.textContent = error.message; resetStatus.classList.add('error'); }
    });

    document.getElementById('cancel-reset').addEventListener('click', () => {
      resetForm.hidden = true;
      resetForm.classList.remove('active');
      form.hidden = false;
      resetToken = '';
    });
  </script>
</Layout>
