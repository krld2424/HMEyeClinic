---
import Layout from '../layouts/Layout.astro';
import logoBlue from '../assets/logo/HMEC logo blue.png';
---

<Layout title="Login | Hernandez Mercado Eye Clinic">
  <main class="auth-page auth-page-centered">
    <section class="auth-card auth-card-centered">
      <a class="auth-back-link" href="/">
        <img src={logoBlue.src} alt="Hernandez Mercado Eye Clinic" />
      </a>
      <h1>Welcome back</h1>
      <p class="auth-intro">Sign in to continue to your clinic workspace.</p>

      <form id="login-form" class="auth-form active">
        <div class="field-group">
          <label for="login-email">Email</label>
          <input id="login-email" name="email" type="email" placeholder="name@example.com" required />
        </div>
        <div class="field-group">
          <label for="login-password">Password</label>
          <div class="password-field">
            <input id="login-password" name="password" type="password" placeholder="Enter your password" required />
            <button class="password-toggle" type="button" data-password-toggle="login-password" aria-label="Show password">Show</button>
          </div>
        </div>
        <div class="field-group password-row">
          <a class="auth-forgot-link" href="/reset-password">Forgot password?</a>
        </div>
        <div class="field-group turnstile-field">
          <div
            class="cf-turnstile"
            data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
            data-callback="onTurnstileSuccess"
            data-expired-callback="onTurnstileExpired"
            data-error-callback="onTurnstileError"
          ></div>
        </div>
        <button type="submit" class="btn btn-primary auth-submit" disabled>Sign In</button>
        <p id="login-status" class="form-status" aria-live="polite"></p>
      </form>
      <p class="auth-switch">New patient? <a href="/register">Create an account</a></p>
    </section>
  </main>

  <style>
    .password-row {
      margin-top: -0.25rem;
    }

    .auth-forgot-link {
      display: inline-block;
      margin-left: auto;
      font-size: 0.9rem;
      color: var(--accent);
      text-decoration: none;
    }

    .turnstile-field {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 0.5rem 0 0.75rem;
    }

    .cf-turnstile {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      min-height: 65px;
    }
  </style>

  <script type="module">
    const clearSessionState = () => {
      ['hmVisionToken', 'hmVisionUser'].forEach((key) => localStorage.removeItem(key));
    };

    const token = localStorage.getItem('hmVisionToken');
    let user = null;
    try {
      user = JSON.parse(localStorage.getItem('hmVisionUser') || 'null');
    } catch {
      clearSessionState();
    }

    if (token && user && user.role) {
      window.location.href = `/dashboard/${user.role}/dashboard`;
    } else if (token || user) {
      clearSessionState();
    }

    const form = document.getElementById('login-form');
    const status = document.getElementById('login-status');
    const submitButton = form.querySelector('button[type="submit"]');
    const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
    let turnstileVerified = true;

    const api = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';

    const updateSubmitState = () => {
      const isBusy = form.dataset.submitting === 'true';
      submitButton.disabled = isBusy;
      submitButton.setAttribute('aria-busy', String(isBusy));
      submitButton.textContent = isBusy ? 'Signing in...' : 'Sign In';
    };

    window.onTurnstileSuccess = () => {
      turnstileVerified = true;
      updateSubmitState();
    };

    window.onTurnstileExpired = () => {
      turnstileVerified = true;
      updateSubmitState();
    };

    window.onTurnstileError = () => {
      turnstileVerified = true;
      updateSubmitState();
    };

    const setSubmittingState = (isSubmitting) => {
      form.dataset.submitting = String(isSubmitting);
      updateSubmitState();
    };

    if (!turnstileKey) {
      status.textContent = 'Turnstile is disabled.';
      status.classList.remove('error');
    }

    document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const input = document.getElementById(toggle.dataset.passwordToggle);
        const visible = input.type === 'password';
        input.type = visible ? 'text' : 'password';
        toggle.textContent = visible ? 'Hide' : 'Show';
        toggle.setAttribute('aria-label', `${visible ? 'Hide' : 'Show'} password`);
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (form.dataset.submitting === 'true') return;

      const turnstileToken = document.querySelector('[name="cf-turnstile-response"]')?.value;
      if (turnstileToken) {
        status.textContent = 'Security verification is temporarily disabled.';
        status.classList.remove('error');
      }

      setSubmittingState(true);
      status.textContent = 'Signing in...';
      status.classList.remove('error');

      try {
        const formData = Object.fromEntries(new FormData(form).entries());
        delete formData['cf-turnstile-response'];

        const response = await fetch(`${api}/api/auth/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...formData, turnstileToken }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to sign in.');
        localStorage.setItem('hmVisionToken', result.token);
        localStorage.setItem('hmVisionUser', JSON.stringify(result.user));
        window.location.href = `/dashboard/${result.user.role}/dashboard`;
      } catch (error) {
        status.textContent = error.message;
        status.classList.add('error');
        setSubmittingState(false);
      }
    });

  </script>
</Layout>
