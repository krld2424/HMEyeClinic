---
import Layout from '../layouts/Layout.astro';
import logoBlue from '../assets/logo/HMEC logo blue.png';
---

<Layout title="Patient Registration | Hernandez Mercado Eye Clinic">
  <main class="auth-page auth-page-centered">
    <section class="auth-card auth-card-centered auth-card-register">
      <a class="auth-back-link" href="/">
        <img src={logoBlue.src} alt="Hernandez Mercado Eye Clinic" />
      </a>
      <h1>Create your account</h1>
      <p class="auth-intro">Your registration automatically creates a Patient account.</p>

      <form id="register-form" class="auth-form active">
        <div class="field-row">
          <div class="field-group"><label for="first-name">First name</label><input id="first-name" name="firstName" type="text" required /></div>
          <div class="field-group"><label for="last-name">Last name</label><input id="last-name" name="lastName" type="text" required /></div>
        </div>
        <div class="field-row">
          <div class="field-group"><label for="middle-initial">Middle initial</label><input id="middle-initial" name="middleInitial" type="text" maxlength="1" pattern="[A-Za-z]?" /></div>
          <div class="field-group"><label for="suffix">Suffix</label><input id="suffix" name="suffix" type="text" placeholder="Jr., Sr., III" /></div>
        </div>
        <div class="field-row">
          <div class="field-group"><label for="age">Age</label><input id="age" name="age" type="number" inputmode="numeric" min="0" max="120" step="1" pattern="[0-9]*" required /></div>
          <div class="field-group"><label for="gender">Gender</label><select id="gender" name="gender" required><option value="">Select gender</option><option>Female</option><option>Male</option><option>Non-binary</option><option>Prefer not to say</option></select></div>
        </div>
        <div class="field-group"><label for="register-email">Email</label><input id="register-email" name="email" type="email" placeholder="name@example.com" required /></div>
        <div class="field-group"><label for="register-phone">Contact number</label><input id="register-phone" name="phone" type="tel" inputmode="tel" placeholder="+63 000-000-0000" pattern="\+63 [0-9]{3}-[0-9]{3}-[0-9]{4}" maxlength="16" required /></div>
        <div class="field-group"><label for="register-password">Password</label><div class="password-field"><input id="register-password" name="password" type="password" minlength="8" required /><button class="password-toggle" type="button" data-password-toggle="register-password" aria-label="Show password">Show</button></div></div>
        <div class="field-group"><label for="confirm-password">Confirm password</label><div class="password-field"><input id="confirm-password" name="confirmPassword" type="password" minlength="8" required /><button class="password-toggle" type="button" data-password-toggle="confirm-password" aria-label="Show password">Show</button></div></div>
        <button type="submit" class="btn btn-primary auth-submit">Create Patient Account</button>
        <p id="register-status" class="form-status" aria-live="polite"></p>
      </form>
      <p class="auth-switch">Already registered? <a href="/login">Sign in</a></p>
    </section>
  </main>

  <dialog id="registration-success-dialog" class="registration-success-dialog" aria-labelledby="registration-success-title">
    <div class="registration-success-dialog__content">
      <div class="registration-success-icon" aria-hidden="true">✓</div>
      <h2 id="registration-success-title">Account created</h2>
      <p>Your patient account has been created successfully. You can sign in and continue to your patient dashboard from the login page.</p>
      <div class="registration-success-actions">
        <a href="/login" class="btn btn-primary">Go to sign in</a>
        <button type="button" class="btn btn-secondary" id="close-registration-success-dialog">Close</button>
      </div>
    </div>
  </dialog>

  <style>
    .registration-success-dialog {
      width: min(480px, calc(100vw - 2rem));
      border: none;
      border-radius: 22px;
      padding: 0;
      background: #ffffff;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18);
    }

    .registration-success-dialog::backdrop {
      background: rgba(15, 23, 42, 0.48);
    }

    .registration-success-dialog__content {
      display: grid;
      justify-items: center;
      gap: 1rem;
      padding: 2rem 1.5rem 1.5rem;
      text-align: center;
    }

    .registration-success-icon {
      display: grid;
      place-items: center;
      width: 4rem;
      height: 4rem;
      border-radius: 50%;
      background: rgba(16, 185, 129, 0.12);
      color: #097963;
      font-size: 2rem;
      font-weight: 700;
    }

    .registration-success-dialog h2 {
      margin: 0;
      color: var(--heading-color, #102a43);
      font-size: clamp(1.35rem, 2vw, 1.7rem);
    }

    .registration-success-dialog p {
      margin: 0;
      color: var(--muted, #52607a);
      line-height: 1.6;
    }

    .registration-success-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      width: 100%;
      margin-top: 0.25rem;
    }
  </style>

  <script type="module">
    const token = localStorage.getItem('hmVisionToken');
    const user = JSON.parse(localStorage.getItem('hmVisionUser') || 'null');
    if (token && user && user.role) {
      window.location.href = `/dashboard/${user.role}/dashboard`;
    }

    const form = document.getElementById('register-form');
    const status = document.getElementById('register-status');
    const phone = document.getElementById('register-phone');
    const age = document.getElementById('age');
    const successDialog = document.getElementById('registration-success-dialog');
    const closeSuccessDialogButton = document.getElementById('close-registration-success-dialog');

    const openSuccessDialog = () => {
      if (successDialog && typeof successDialog.showModal === 'function') {
        successDialog.showModal();
      }
    };

    closeSuccessDialogButton?.addEventListener('click', () => {
      if (successDialog && typeof successDialog.close === 'function') {
        successDialog.close();
      }
    });

    const formatPhone = (value) => {
      const digits = value.replace(/\D/g, '').replace(/^63/, '').slice(0, 10);
      const groups = [digits.slice(0, 3), digits.slice(3, 6), digits.slice(6, 10)].filter(Boolean);
      return groups.length ? `+63 ${groups.join('-')}` : '';
    };
    phone.addEventListener('input', () => { phone.value = formatPhone(phone.value); });
    age.addEventListener('input', () => { age.value = age.value.replace(/\D/g, '').slice(0, 3); });

    document.querySelectorAll('[data-password-toggle]').forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const input = document.getElementById(toggle.dataset.passwordToggle);
        const visible = input.type === 'password';
        input.type = visible ? 'text' : 'password';
        toggle.textContent = visible ? 'Hide' : 'Show';
        toggle.setAttribute('aria-label', `${visible ? 'Hide' : 'Show'} password`);
      });
    });

    const api = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      const payload = Object.fromEntries(new FormData(form).entries());
      const ageValue = Number(payload.age);
      if (!Number.isInteger(ageValue) || ageValue < 0 || ageValue > 120) {
        status.textContent = 'Age must be a whole number between 0 and 120.';
        status.classList.add('error');
        return;
      }
      if (payload.phone && !/^\+63 \d{3}-\d{3}-\d{4}$/.test(payload.phone)) {
        status.textContent = 'Phone number must use +63 000-000-0000 format.';
        status.classList.add('error');
        return;
      }
      if (payload.password !== payload.confirmPassword) { status.textContent = 'Passwords do not match.'; status.classList.add('error'); return; }
      delete payload.confirmPassword;
      payload.name = [payload.firstName, payload.middleInitial ? `${payload.middleInitial}.` : '', payload.lastName, payload.suffix].filter(Boolean).join(' ');

      try {
        const response = await fetch(`${api}/api/auth/register`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to create account.');

        status.textContent = 'Account created successfully.';
        status.classList.remove('error');
        status.classList.add('success');
        form.reset();
        openSuccessDialog();
      } catch (error) {
        status.textContent = error.message;
        status.classList.remove('success');
        status.classList.add('error');
      }
    });
  </script>
</Layout>
