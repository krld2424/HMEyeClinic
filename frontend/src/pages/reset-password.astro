---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Find Your Account | Hernandez Mercado Eye Clinic">
  <main class="auth-page auth-page-centered">
    <section class="auth-card auth-card-centered reset-card">
      <a class="auth-back-link" href="/login">Back to sign in</a>
      <ol class="reset-progress" aria-label="Password reset progress">
        <li class="is-current"><span>1</span><strong>Account email</strong></li>
        <li><span>2</span><strong>Verification code</strong></li>
        <li><span>3</span><strong>New password</strong></li>
      </ol>
      <div class="reset-step is-active">
        <span class="eyebrow">Password reset</span>
        <div class="reset-heading"><h1>Find your account</h1><p>Enter your account email and we will send you a verification code.</p></div>
        <form id="reset-email-form" class="auth-form active">
          <div class="field-group"><label for="reset-email">Account email</label><input id="reset-email" type="email" autocomplete="email" required /></div>
          <button type="submit" class="btn btn-primary reset-action">Send reset code</button>
          <p id="reset-status" class="form-status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
  <script type="module">
    const form = document.getElementById('reset-email-form');
    const email = document.getElementById('reset-email');
    const status = document.getElementById('reset-status');
    const api = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }
      status.textContent = 'Sending reset code...';
      status.classList.remove('error');
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      try {
        const response = await fetch(`${api}/api/auth/forgot-password`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email.value.trim() }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to request a reset code.');
        sessionStorage.setItem('resetEmail', email.value.trim().toLowerCase());
        sessionStorage.setItem('resetExpiresAt', String(Date.now() + 10 * 60 * 1000));
        window.location.href = '/reset-password/code';
      } catch (error) { status.textContent = error.message; status.classList.add('error'); }
      finally { button.disabled = false; }
    });
  </script>
</Layout>
