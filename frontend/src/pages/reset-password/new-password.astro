---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Set a New Password | Hernandez Mercado Eye Clinic">
  <main class="auth-page auth-page-centered">
    <section class="auth-card auth-card-centered reset-card">
      <ol class="reset-progress" aria-label="Password reset progress">
        <li class="is-complete"><span>1</span><strong>Account email</strong></li>
        <li class="is-complete"><span>2</span><strong>Verification code</strong></li>
        <li class="is-current"><span>3</span><strong>New password</strong></li>
      </ol>
      <div class="reset-step is-active">
        <span class="eyebrow">Step 3 of 3</span>
        <div class="reset-heading"><h1>Set a new password</h1><p>Create a strong password for your account.</p></div>
        <form id="new-password-form" class="auth-form active">
          <div class="field-group"><label for="reset-password">Password</label><div class="password-field"><input id="reset-password" type="password" minlength="8" required /><button class="password-toggle" type="button" data-password-toggle="reset-password" aria-label="Show password">Show</button></div></div>
          <div class="field-group"><label for="reset-confirm-password">Confirmed password</label><div class="password-field"><input id="reset-confirm-password" type="password" minlength="8" required /><button class="password-toggle" type="button" data-password-toggle="reset-confirm-password" aria-label="Show password">Show</button></div></div>
          <ul class="password-requirements"><li data-requirement="length">8+ characters</li><li data-requirement="case">1 uppercase + lowercase</li><li data-requirement="number">1 number</li><li data-requirement="special">1 special character</li></ul>
          <button type="submit" class="btn btn-primary auth-submit">Reset password</button>
          <p id="reset-status" class="form-status" aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>
  <script type="module">
    const resetToken = sessionStorage.getItem('resetToken');
    if (!resetToken) window.location.replace('/reset-password');

    const form = document.getElementById('new-password-form');
    const password = document.getElementById('reset-password');
    const confirmPassword = document.getElementById('reset-confirm-password');
    const status = document.getElementById('reset-status');
    const api = import.meta.env.PUBLIC_API_URL || 'http://localhost:5000';
    const requirements = {
      length: (value) => value.length >= 8,
      case: (value) => /[a-z]/.test(value) && /[A-Z]/.test(value),
      number: (value) => /\d/.test(value),
      special: (value) => /[^A-Za-z0-9]/.test(value),
    };
    const updateRequirements = () => Object.entries(requirements).forEach(([name, test]) => document.querySelector(`[data-requirement="${name}"]`).classList.toggle('is-met', test(password.value)));
    password.addEventListener('input', updateRequirements);
    document.querySelectorAll('[data-password-toggle]').forEach((toggle) => toggle.addEventListener('click', () => {
      const input = document.getElementById(toggle.dataset.passwordToggle);
      const visible = input.type === 'password';
      input.type = visible ? 'text' : 'password';
      toggle.textContent = visible ? 'Hide' : 'Show';
    }));

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!Object.values(requirements).every((test) => test(password.value))) { status.textContent = 'Password does not meet all requirements.'; status.classList.add('error'); return; }
      if (password.value !== confirmPassword.value) { status.textContent = 'Passwords do not match.'; status.classList.add('error'); return; }
      status.textContent = 'Updating password...';
      try {
        const response = await fetch(`${api}/api/auth/reset-password`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ resetToken, password: password.value }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Unable to reset password.');
        sessionStorage.removeItem('resetToken');
        sessionStorage.removeItem('resetEmail');
        sessionStorage.removeItem('resetExpiresAt');
        status.textContent = 'Password reset successfully. Redirecting to sign in...';
        window.setTimeout(() => { window.location.href = '/login'; }, 1000);
      } catch (error) { status.textContent = error.message; status.classList.add('error'); }
    });
  </script>
</Layout>
