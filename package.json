{
  "name": "hm-visionsync",
  "private": true,
  "scripts": {
    "start": "cd backend && npm start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev -- --host 0.0.0.0",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview -- --host 0.0.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@lucide/astro": "^1.34.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.6.3",
    "nodemailer": "^9.0.5",
    "resend": "^6.22.1",
    "xlsx": "^0.18.5"
  }
}
